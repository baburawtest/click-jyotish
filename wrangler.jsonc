{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "click-jyotish",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-11",
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "LEADS_DB"
    }
  ],
  "ratelimits": [
    {
      "name": "PALM_RATE_LIMITER",
      "namespace_id": "20261120",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin/*"]
  }
}
