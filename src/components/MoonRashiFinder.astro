-rashi-name-help summary{cursor:pointer;color:#31556a;font-weight:800}.moon-rashi-name-help p{max-width:800px;margin:9px 0 12px;font-size:13px;line-height:1.55}.moon-rashi-name-help div{display:flex;gap:10px}.moon-rashi-name-help input{flex:1;min-height:45px;padding:0 12px;border:1px solid #bcd4e0;border-radius:8px;background:#fffdf9;font:inherit}.moon-rashi-name-help a{min-height:45px}@media(max-width:800px){.moon-rashi-card{padding:25px 21px}.moon-rashi-form{grid-template-columns:1fr 1fr}.moon-rashi-form label:nth-child(3),.moon-rashi-form button{grid-column:1/-1}.moon-rashi-name-help div{flex-direction:column}.moon-rashi-name-help a{width:100%;box-sizing:border-box}}@media(max-width:480px){.moon-rashi-form{grid-template-columns:1fr}.moon-rashi-form label:nth-child(3),.moon-rashi-form button{grid-column:auto}}
</style>
