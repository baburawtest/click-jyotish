<section class="moon-rashi-finder" aria-labelledby="moon-rashi-title">
  <div class="wrap"><div class="moon-rashi-card">
    <div class="moon-rashi-copy">
      <p class="moon-rashi-eyebrow">CHANDRA RASHI · जन्म राशि</p>
      <h2 id="moon-rashi-title">Do you know your Moon sign?</h2>
      <p>Daily Rashifal is read from your <strong>Janma Rashi</strong>—the sidereal sign occupied by Chandra at birth, not your Western Sun sign.</p>
      <p class="moon-rashi-privacy">🔒 Your details are calculated only in this browser. Click Jyotish does not save them.</p>
    </div>
    <form id="moon-rashi-form" class="moon-rashi-form">
      <label for="moon-rashi-date"><span>Date of birth</span><input id="moon-rashi-date" name="birthDate" type="date" required /></label>
      <label for="moon-rashi-time"><span>Time of birth</span><input id="moon-rashi-time" name="birthTime" type="time" required /></label>
      <label for="moon-rashi-place"><span>Place of birth (India)</span><input id="moon-rashi-place" name="birthPlace" type="text" placeholder="e.g. New Delhi" autocomplete="address-level2" required /></label>
      <button type="submit">Know my Chandra Rashi →</button>
      <small>For births outside India or an uncertain birth time, request a personal check below.</small>
    </form>
    <div id="moon-rashi-result" class="moon-rashi-result" hidden aria-live="polite">
      <p class="moon-result-label">YOUR JANMA RASHI · आपकी जन्म राशि</p>
      <h3 id="moon-rashi-result-title"></h3><p id="moon-rashi-result-copy"></p>
      <a id="moon-rashi-read-link" href="#rashifal">Read my Rashifal ↓</a>
    </div>
    <details class="moon-rashi-name-help"><summary>Birth time not known? Ask through your birth name</summary><p>A name alone cannot calculate an exact Moon Rashi. If your name was chosen through <em>Namkaran</em>, it can be a traditional clue to the birth Nakshatra. Deepak can review it personally.</p><div><input id="moon-rashi-name" type="text" placeholder="Name used at Namkaran" autocomplete="name" /><a id="moon-rashi-name-link" href="https://wa.me/917669655530" target="_blank" rel="noreferrer">Ask Deepak on WhatsApp</a></div></details>
  </div></div>
</section>

<script>
  import { EclipticGeoMoon } from 'astronomy-engine';
  const rashis = [
    { id: 'aries', name: 'Mesha', hi: 'मेष', english: 'Aries' }, { id: 'taurus', name: 'Vrishabha', hi: 'वृषभ', english: 'Taurus' }, { id: 'gemini', name: 'Mithuna', hi: 'मिथुन', english: 'Gemini' }, { id: 'cancer', name: 'Karka', hi: 'कर्क', english: 'Cancer' }, { id: 'leo', name: 'Simha', hi: 'सिंह', english: 'Leo' }, { id: 'virgo', name: 'Kanya', hi: 'कन्या', english: 'Virgo' }, { id: 'libra', name: 'Tula', hi: 'तुला', english: 'Libra' }, { id: 'scorpio', name: 'Vrishchika', hi: 'वृश्चिक', english: 'Scorpio' }, { id: 'sagittarius', name: 'Dhanu', hi: 'धनु', english: 'Sagittarius' }, { id: 'capricorn', name: 'Makara', hi: 'मकर', english: 'Capricorn' }, { id: 'aquarius', name: 'Kumbha', hi: 'कुंभ', english: 'Aquarius' }, { id: 'pisces', name: 'Meena', hi: 'मीन', english: 'Pisces' }
  ];
  function lahiriAyanamsa(date: Date) { const jd = date.getTime() / 86400000 + 2440587.5; return 23.85675 + ((jd - 2451545) / 365.2425) * 0.013968; }
  const normalize = (degrees: number) => ((degrees % 360) + 360) % 360;
  function setupMoonRashiFinder() {
    const form = document.getElementById('moon-rashi-form') as HTMLFormElement | null; const result = document.getElementById('moon-rashi-result') as HTMLElement | null; const title = document.getElementById('moon-rashi-result-title'); const copy = document.getElementById('moon-rashi-result-copy'); const rashifalLink = document.getElementById('moon-rashi-read-link') as HTMLAnchorElement | null; const nameInput = document.getElementById('moon-rashi-name') as HTMLInputElement | null; const nameLink = document.getElementById('moon-rashi-name-link') as HTMLAnchorElement | null;
    if (!form || !result || form.dataset.ready === 'true') return; form.dataset.ready = 'true';
    form.addEventListener('submit', (event) => { event.preventDefault(); if (!form.reportValidity()) return; const details = new FormData(form); const birthDate = new Date(`${String(details.get('birthDate'))}T${String(details.get('birthTime'))}:00+05:30`); const tropicalLongitude = EclipticGeoMoon(birthDate).lon; const siderealLongitude = normalize(tropicalLongitude - lahiriAyanamsa(birthDate)); const index = Math.floor(siderealLongitude / 30); const rashi = rashis[index]; const degreeInRashi = siderealLongitude % 30; const nearBoundary = degreeInRashi < 0.5 || degreeInRashi > 29.5; if (title) title.textContent = `${rashi.name} (${rashi.hi}) · ${rashi.english}`; if (copy) copy.textContent = nearBoundary ? 'This result is close to a Rashi boundary. For an important decision, request a precision Kundli review with the most accurate available birth time.' : `Use ${rashi.name} / ${rashi.hi} to read your Daily Rashifal below. This is a sidereal Lahiri Moon-Rashi calculation for the entered India (IST) birth time.`; if (rashifalLink) rashifalLink.onclick = () => document.getElementById(`tab-${rashi.id}`)?.click(); result.hidden = false; result.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); });
    nameLink?.addEventListener('click', () => { const name = nameInput?.value.trim() || 'Not provided'; const message = `Namaste Deepak, I would like help finding my Chandra Rashi through the traditional Namkaran/birth-name method. My name used at Namkaran is: ${name}. I do not know my exact birth time. Please guide me.`; nameLink.href = `https://wa.me/917669655530?text=${encodeURIComponent(message)}`; });
  }
  setupMoonRashiFinder(); document.addEventListener('astro:page-load', setupMoonRashiFinder);
</script>

