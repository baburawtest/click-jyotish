  function lahiriAyanamsa(date: Date) { const jd = date.getTime() / 86400000 + 2440587.5; return 23.85675 + ((jd - 2451545) / 365.2425) * 0.013968; }
  const normalize = (degrees: number) => ((degrees % 360) + 360) % 360;
  function setupMoonRashiFinder() {
    const form = document.getElementById('moon-rashi-form') as HTMLFormElement | null; const result = document.getElementById('moon-rashi-result') as HTMLElement | null; const title = document.getElementById('moon-rashi-result-title'); const copy = document.getElementById('moon-rashi-result-copy'); const rashifalLink = document.getElementById('moon-rashi-read-link') as HTMLAnchorElement | null; const nameForm = document.getElementById('moon-rashi-name-form') as HTMLFormElement | null; const nameInput = document.getElementById('moon-rashi-name') as HTMLInputElement | null; const nameResult = document.getElementById('moon-rashi-name-result') as HTMLElement | null; const nameResultTitle = document.getElementById('moon-rashi-name-result-title'); const nameResultCopy = document.getElementById('moon-rashi-name-result-copy');
    if (!form || !result || form.dataset.ready === 'true') return; form.dataset.ready = 'true';
    let language: 'en' | 'hi' = localStorage.getItem('click-jyotish-language') === 'hi' ? 'hi' : 'en';
    let lastResult: { rashi: typeof rashis[number]; nearBoundary: boolean } | null = null;
    const renderResult = () => {
      if (!lastResult) return;
      const text = moonCopy[language]; const { rashi, nearBoundary } = lastResult;
      if (title) title.textContent = `${rashi.name} (${rashi.hi}) · ${rashi.english}`;
      if (copy) copy.textContent = nearBoundary ? text.boundary : text.result.replace('{name}', rashi.name).replace('{hi}', rashi.hi);
    };
    const applyMoonLanguage = (nextLanguage: 'en' | 'hi') => {
      language = nextLanguage; const text = moonCopy[language];
      const section = document.querySelector('.moon-rashi-finder');
      const intro = section?.querySelector<HTMLElement>('.moon-rashi-intro');
      if (intro) intro.innerHTML = text.intro;
      const set = (selector: string, value: string) => { const element = section?.querySelector<HTMLElement>(selector); if (element) element.textContent = value; };
      set('.moon-rashi-eyebrow', text.eyebrow); set('#moon-rashi-title', text.title); set('.moon-rashi-privacy', text.privacy);
      section?.querySelectorAll<HTMLElement>('.moon-rashi-form label span').forEach((element, index) => { element.textContent = text.labels[index] || element.textContent; });
      const place = section?.querySelector<HTMLInputElement>('#moon-rashi-place'); if (place) place.placeholder = text.place;
      set('.moon-rashi-form button', text.submit); set('.moon-rashi-form small', text.outside); set('.moon-result-label', text.resultLabel); set('#moon-rashi-read-link', text.read);
      set('.moon-rashi-name-help > summary', text.unknown); const nameDescription = section?.querySelector<HTMLElement>('.moon-rashi-name-description'); if (nameDescription) nameDescription.innerHTML = text.nameHelp; const name = section?.querySelector<HTMLInputElement>('#moon-rashi-name'); if (name) name.placeholder = text.namePlaceholder; set('#moon-rashi-name-submit', text.ask); set('.moon-rashi-name-result-label', text.nameResultLabel); set('.moon-rashi-name-exact-link', text.nameExact); set('.moon-rashi-letter-chart summary', text.letterGuide); set('.moon-rashi-letter-guide-copy', text.letterGuideCopy);
      renderResult();
    };
    form.addEventListener('submit', (event) => { event.preventDefault(); if (!form.reportValidity()) return; const details = new FormData(form); const birthDate = new Date(`${String(details.get('birthDate'))}T${String(details.get('birthTime'))}:00+05:30`); const tropicalLongitude = EclipticGeoMoon(birthDate).lon; const siderealLongitude = normalize(tropicalLongitude - lahiriAyanamsa(birthDate)); const index = Math.floor(siderealLongitude / 30); const rashi = rashis[index]; const degreeInRashi = siderealLongitude % 30; lastResult = { rashi, nearBoundary: degreeInRashi < 0.5 || degreeInRashi > 29.5 }; renderResult(); if (rashifalLink) rashifalLink.onclick = () => document.getElementById(`tab-${rashi.id}`)?.click(); result.hidden = false; result.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); });
    nameForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const enteredName = nameInput?.value.trim() || '';
      if (!enteredName || !nameResult || !nameResultTitle || !nameResultCopy) return;
      const normalizedName = enteredName.toLocaleLowerCase('hi-IN').replace(/\s+/g, '');
      const matchingSounds = naamRashiSounds.flatMap((entry) => [...entry.hi, ...entry.en].map((sound) => ({ id: entry.id, sound }))).filter(({ sound }) => normalizedName.startsWith(sound.toLocaleLowerCase('hi-IN')));
      const longestLength = Math.max(0, ...matchingSounds.map(({ sound }) => sound.length));
      const matches = matchingSounds.filter(({ sound }) => sound.length === longestLength);
      const uniqueIds = [...new Set(matches.map(({ id }) => id))];
      const text = moonCopy[language];
      if (!matches.length) {
        nameResultTitle.textContent = language === 'hi' ? 'नाम राशि का मिलान नहीं हुआ' : 'Naam Rashi not matched';
        nameResultCopy.textContent = text.nameNoMatch;
      } else if (uniqueIds.length === 1) {
        const rashi = rashis.find(({ id }) => id === uniqueIds[0]);
        const sound = matches[0].sound;
        if (!rashi) return;
        nameResultTitle.textContent = `${rashi.name} (${rashi.hi}) · ${rashi.english}`;
        nameResultCopy.textContent = text.nameResult.replace('{sound}', sound).replace('{name}', rashi.name).replace('{hi}', rashi.hi).replace('{english}', rashi.english);
      } else {
        const sound = matches[0].sound;
        const options = uniqueIds.map((id) => {
          const rashi = rashis.find((entry) => entry.id === id);
          return rashi ? `${rashi.hi} (${rashi.english})` : id;
        }).join(language === 'hi' ? ' / ' : ' or ');
        nameResultTitle.textContent = language === 'hi' ? 'एक से अधिक नाम राशि संभव है' : 'More than one Naam Rashi is possible';
        nameResultCopy.textContent = text.nameAmbiguous.replace('{sound}', sound).replace('{options}', options);
      }
      nameResult.hidden = false;
      nameResult.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
    applyMoonLanguage(language);
    document.addEventListener('click-jyotish-language-change', ((event: Event) => { const nextLanguage = (event as CustomEvent<{ language?: 'en' | 'hi' }>).detail?.language; applyMoonLanguage(nextLanguage === 'hi' ? 'hi' : 'en'); }) as EventListener);
  }
  setupMoonRashiFinder(); document.addEventListener('astro:page-load', setupMoonRashiFinder);
