    { id: 'aquarius', hi: ['गू', 'गु', 'गे', 'गो', 'सा', 'सी', 'सू', 'सु', 'से', 'सो', 'दा'], en: ['goo', 'gu', 'ge', 'go', 'saa', 'sa', 'si', 'soo', 'su', 'se', 'so', 'daa', 'da'] },
    { id: 'pisces', hi: ['दी', 'दू', 'दु', 'थ', 'झ', 'ञ', 'दे', 'दो', 'चा', 'ची'], en: ['dee', 'di', 'doo', 'du', 'tha', 'jha', 'nya', 'de', 'do', 'chaa', 'cha', 'chi'] }
  ] as const;
  const moonCopy = {
    en: {
      eyebrow: 'CHANDRA RASHI · जन्म राशि', title: 'Do you know your Moon sign?',
      intro: 'Daily Rashifal is read from your <strong>Janma Rashi</strong>—the sidereal sign occupied by Chandra at birth, not your Western Sun sign.',
      privacy: '🔒 Your details are calculated only in this browser. Click Jyotish does not save them.',
      labels: ['Date of birth', 'Time of birth', 'Place of birth (India)'], place: 'e.g. New Delhi', submit: 'Know my Chandra Rashi →',
      outside: 'For births outside India or an uncertain birth time, request a personal check below.', resultLabel: 'YOUR JANMA RASHI · आपकी जन्म राशि',
      read: 'Read my Rashifal ↓', unknown: 'Birth time not known? Find your Naam Rashi',
      nameHelp: 'Enter the first sound of the name given at <em>Namkaran</em> for an instant traditional <strong>Naam Rashi</strong> clue. It is not an exact Chandra Rashi; names and regional naming charts can vary.',
      namePlaceholder: 'e.g. Rahul / राहुल', ask: 'Find my Naam Rashi →', nameResultLabel: 'TRADITIONAL NAAM RASHI',
      nameResult: 'The opening sound “{sound}” traditionally maps to {name} ({hi}) · {english}. For an exact Chandra Rashi, use your birth date, time and place above.',
