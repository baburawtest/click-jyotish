      boundary: 'This result is close to a Rashi boundary. For an important decision, request a precision Kundli review with the most accurate available birth time.',
      result: 'Use {name} / {hi} to read your Daily Rashifal below. This is a sidereal Lahiri Moon-Rashi calculation for the entered India (IST) birth time.'
    },
    hi: {
      eyebrow: 'चंद्र राशि · जन्म राशि', title: 'क्या आप अपनी चंद्र राशि जानते हैं?',
      intro: 'दैनिक राशिफल आपकी <strong>जन्म राशि</strong> से पढ़ा जाता है—जन्म के समय चंद्रमा जिस राशि में था, उससे; आपकी पश्चिमी सूर्य राशि से नहीं।',
      privacy: '🔒 आपकी जानकारी केवल इसी ब्राउज़र में गणना होती है। Click Jyotish इसे सुरक्षित नहीं करता।',
      labels: ['जन्म तिथि', 'जन्म समय', 'जन्म स्थान (भारत)'], place: 'उदाहरण: नई दिल्ली', submit: 'मेरी चंद्र राशि जानें →',
      outside: 'भारत के बाहर जन्म या जन्म समय निश्चित न होने पर नीचे व्यक्तिगत जाँच का अनुरोध करें।', resultLabel: 'आपकी जन्म राशि',
      read: 'मेरा राशिफल पढ़ें ↓', unknown: 'जन्म समय नहीं पता? अपनी नाम राशि जानें',
      nameHelp: 'नामकरण में रखे गए नाम की पहली ध्वनि डालें और पारंपरिक <strong>नाम राशि</strong> का संकेत तुरंत पाएं। यह सटीक चंद्र राशि नहीं है; नाम और क्षेत्रीय परंपराएँ अलग हो सकती हैं।',
      namePlaceholder: 'उदाहरण: राहुल / Rahul', ask: 'मेरी नाम राशि जानें →', nameResultLabel: 'पारंपरिक नाम राशि',
      nameResult: 'नाम की पहली ध्वनि “{sound}” के अनुसार पारंपरिक नाम राशि {name} ({hi}) · {english} है। सटीक चंद्र राशि के लिए ऊपर जन्म तिथि, समय और स्थान भरें।',
      nameAmbiguous: 'पहली ध्वनि “{sound}” एक से अधिक पारंपरिक नामकरण तालिकाओं में आती है: {options}। सटीक चंद्र राशि के लिए ऊपर जन्म विवरण भरें।',
      nameNoMatch: 'पहली ध्वनि का मिलान नहीं हुआ। नामकरण में बोली जाने वाली ध्वनि लिखें—संभव हो तो हिंदी में।', nameExact: 'सटीक चंद्र राशि के लिए जन्म विवरण भरें ↑', letterGuide: 'पारंपरिक नाम राशि अक्षर तालिका देखें', letterGuideCopy: 'ये सामान्य नामकरण ध्वनियाँ केवल सहायक संदर्भ हैं। परिवार और क्षेत्र के अनुसार उच्चारण व परंपरा अलग हो सकती है।',
      boundary: 'यह परिणाम राशि की सीमा के बहुत निकट है। महत्वपूर्ण निर्णय के लिए सबसे सटीक उपलब्ध जन्म समय के साथ कुंडली की व्यक्तिगत जाँच लें।',
