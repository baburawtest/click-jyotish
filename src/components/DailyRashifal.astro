---
import { zodiacSigns } from '../data/zodiac';
import { site } from '../data/site';
---

<section id="rashifal" class="section rashifal-section">
  <div class="wrap">
    <div class="section-header text-center">
      <p class="eyebrow-text">DAILY HOROSCOPE · दैनिक राशिफल</p>
      <h2>Today's Chandra Rashi Insights</h2>
      <p class="section-desc">Daily guidance for all 12 Rashis, viewed through your Janma Rashi (Moon sign).</p>
      <p class="moon-sign-note"><strong>Choose your Moon sign, not your Sun sign.</strong> In Vedic Jyotish, daily Rashifal is generally read from the Rashi occupied by Chandra (the Moon) at the time of birth. Your date-of-birth Sun-sign range is not used here.</p>
    </div>

    <!-- Zodiac Sign Grid Selector -->
    <div class="zodiac-selector-grid" role="tablist" aria-label="Zodiac signs selector">
      {zodiacSigns.map((z, idx) => (
        <button
          type="button"
          class={`zodiac-chip ${idx === 0 ? 'active' : ''}`}
          data-sign={z.id}
          role="tab"
          aria-selected={idx === 0 ? 'true' : 'false'}
          id={`tab-${z.id}`}
          aria-controls={`panel-${z.id}`}
        >
          <span class="z-icon">{z.icon}</span>
          <div class="z-names">
            <span class="z-en">{z.nameEn}</span>
            <span class="z-hi">{z.nameHi}</span>
          </div>
          <span class="z-date">Janma Rashi · Moon Sign</span>
        </button>
      ))}
    </div>

    <!-- Zodiac Detail Display Panels -->
    <div class="zodiac-panels-wrapper">
      {zodiacSigns.map((z, idx) => (
        <div
          id={`panel-${z.id}`}
          class={`zodiac-card ${idx === 0 ? 'active' : ''}`}
          role="tabpanel"
          aria-labelledby={`tab-${z.id}`}
          data-sign-panel={z.id}
        >
          <!-- Card Top Bar -->
          <div class="z-card-header">
            <div class="z-main-title">
              <div class="z-avatar">
                <span class="z-big-icon">{z.icon}</span>
                <span class="z-symbol">{z.symbol}</span>
              </div>
              <div>
                <div class="z-badge-row">
                  <span class="badge badge-gold">{z.element} Element ({z.elementHi})</span>
                  <span class="badge badge-dark">Ruler: {z.rulingPlanet} ({z.rulingPlanetHi})</span>
                </div>
                <h3>{z.nameEn} ({z.nameHi} - {z.sanskrit})</h3>
                <p class="z-date-range">Read this guidance from your Janma Rashi (Moon sign).</p>
              </div>
            </div>

            <!-- Quick Lucky Stats -->
            <div class="z-lucky-stats">
              <div class="stat-pill">
                <span class="stat-label">Lucky Number</span>
                <span class="stat-val">{z.luckyNumber}</span>
              </div>
              <div class="stat-pill">
                <span class="stat-label">Lucky Color</span>
                <span class="stat-val">{z.luckyColor}</span>
              </div>
              <div class="stat-pill">
                <span class="stat-label">Direction</span>
                <span class="stat-val">{z.luckyDirection}</span>
              </div>
            </div>
          </div>

          <!-- Predictions Grid -->
          <div class="z-predictions-grid">
            <div class="pred-box pred-overview">
              <div class="pred-title">
                <span class="p-icon">✨</span>
                <h4>Today's Cosmic Overview (दैनिक प्रभाव)</h4>
              </div>
              <p class="pred-en">{z.overview.en}</p>
              <p class="pred-hi">{z.overview.hi}</p>
            </div>

            <div class="pred-box pred-career">
              <div class="pred-title">
                <span class="p-icon">💼</span>
                <h4>Career & Wealth (कार्यक्षेत्र व वित्त)</h4>
              </div>
              <p class="pred-en">{z.career.en}</p>
              <p class="pred-hi">{z.career.hi}</p>
            </div>

            <div class="pred-box pred-health">
              <div class="pred-title">
                <span class="p-icon">🌿</span>
                <h4>Health & Energy (स्वास्थ्य व ऊर्जा)</h4>
              </div>
              <p class="pred-en">{z.health.en}</p>
              <p class="pred-hi">{z.health.hi}</p>
            </div>

            <div class="pred-box pred-relationships">
              <div class="pred-title">
                <span class="p-icon">❤️</span>
                <h4>Relationships & Family (प्रेम व परिवार)</h4>
              </div>
              <p class="pred-en">{z.relationships.en}</p>
              <p class="pred-hi">{z.relationships.hi}</p>
            </div>
          </div>

          <!-- Vedic Remedy & Mantra -->
          <div class="remedy-mantra-banner">
            <div class="remedy-col">
              <span class="rm-tag">VEDIC REMEDY · आज का उपाय</span>
              <p class="rm-text">{z.remedy.en}</p>
              <p class="rm-text-hi">{z.remedy.hi}</p>
            </div>
            <div class="mantra-col">
              <span class="rm-tag">PLANETARY BEEJ MANTRA</span>
              <p class="mantra-sanskrit">{z.mantra}</p>
              <span class="mantra-note">Chant 11 or 108 times with pure intention</span>
            </div>
          </div>

          <!-- Custom Astrologer Consultation CTA -->
          <div class="z-cta-footer">
            <p>Want a personalized deep-dive into your <strong>{z.nameEn}</strong> Janam Kundli and Dasha cycles?</p>
            <a
              href={`#book`}
              class="btn btn-gold btn-sm"
              data-set-service={`Kundali Reading - ${z.nameEn}`}
            >
              Request {z.nameEn} Kundali Reading →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function setupZodiacTabs() {
    const chips = document.querySelectorAll<HTMLButtonElement>('.zodiac-chip');
    const panels = document.querySelectorAll<HTMLElement>('[data-sign-panel]');

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const targetSign = chip.getAttribute('data-sign');

        // Update active chip
        chips.forEach((c) => {
          c.classList.remove('active');
          c.setAttribute('aria-selected', 'false');
        });
        chip.classList.add('active');
        chip.setAttribute('aria-selected', 'true');

        // Update active panel with smooth animation
        panels.forEach((panel) => {
          if (panel.getAttribute('data-sign-panel') === targetSign) {
            panel.classList.add('active');
          } else {
            panel.classList.remove('active');
          }
        });
      });
    });
  }

  // Initialize on load & Astro page transitions
  setupZodiacTabs();
  document.addEventListener('astro:page-load', setupZodiacTabs);
</script>

<style>
  .rashifal-section {
    background: #f7f5ed;
    border-top: 1px solid #dedbd1;
    border-bottom: 1px solid #dedbd1;
    padding: 80px 0;
  }
  .text-center {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 40px;
  }
  .moon-sign-note {
    margin: 18px auto 0;
    max-width: 760px;
    padding: 12px 16px;
    border: 1px solid #dfc792;
    border-radius: 8px;
    background: #fff9eb;
    color: #5d4a26;
    font-size: 14px;
    line-height: 1.55;
  }

  /* Zodiac Grid Chips */
  .zodiac-selector-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
    margin-bottom: 30px;
  }
  .zodiac-chip {
    background: #ffffff;
    border: 1px solid #dedbd1;
    border-radius: 8px;
    padding: 12px 10px;
    cursor: pointer;
    text-align: center;
    transition: all 0.25s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    outline: none;
  }
  .zodiac-chip:hover {
    border-color: #c7913e;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(199, 145, 62, 0.12);
  }
  .zodiac-chip.active {
    background: #101936;
    border-color: #101936;
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(16, 25, 54, 0.25);
  }
  .z-icon {
    font-size: 24px;
    line-height: 1;
  }
  .z-names {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .z-en {
    font-weight: 700;
    font-size: 14px;
    color: inherit;
  }
  .z-hi {
    font-size: 12px;
    color: #8896a6;
  }
  .zodiac-chip.active .z-hi {
    color: #c7913e;
  }
  .z-date {
    font-size: 10px;
    color: #94a3b8;
  }
  .zodiac-chip.active .z-date {
    color: #cbd5e1;
  }

  /* Zodiac Panel Card */
  .zodiac-panels-wrapper {
    position: relative;
    min-height: 480px;
  }
  .zodiac-card {
    display: none;
    background: #ffffff;
    border: 1px solid #dedbd1;
    border-radius: 12px;
    padding: 36px 32px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
    animation: fadeIn 0.3s ease forwards;
  }
  .zodiac-card.active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Card Header */
  .z-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 24px;
    border-bottom: 1px solid #f0ece1;
    margin-bottom: 28px;
    flex-wrap: wrap;
    gap: 20px;
  }
  .z-main-title {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .z-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #101936;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border: 2px solid #c7913e;
  }
  .z-big-icon {
    font-size: 30px;
  }
  .z-symbol {
    position: absolute;
    bottom: -4px;
    right: -4px;
    background: #c7913e;
    color: #101936;
    font-size: 12px;
    font-weight: 700;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .z-badge-row {
    display: flex;
    gap: 8px;
    margin-bottom: 6px;
  }
  .badge {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .badge-gold {
    background: #fdf3e2;
    color: #9f681a;
    border: 1px solid #f0d5a3;
  }
  .badge-dark {
    background: #101936;
    color: #ffffff;
  }
  .z-card-header h3 {
    font-size: 26px;
    margin: 0;
    color: #18213d;
  }
  .z-date-range {
    font-size: 13px;
    color: #64748b;
    margin: 2px 0 0;
  }

  /* Lucky Stats */
  .z-lucky-stats {
    display: flex;
    gap: 14px;
  }
  .stat-pill {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 10px 16px;
    border-radius: 6px;
    text-align: center;
  }
  .stat-label {
    display: block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #94a3b8;
  }
  .stat-val {
    font-size: 14px;
    font-weight: 700;
    color: #18213d;
  }

  /* Predictions Grid */
  .z-predictions-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 28px;
  }
  .pred-box {
    background: #faf9f5;
    border: 1px solid #ede8dc;
    border-radius: 8px;
    padding: 20px;
  }
  .pred-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .p-icon {
    font-size: 20px;
  }
  .pred-title h4 {
    font-size: 17px;
    margin: 0;
    color: #18213d;
  }
  .pred-en {
    font-size: 14.5px;
    color: #334155;
    line-height: 1.6;
    margin: 0 0 10px;
  }
  .pred-hi {
    font-size: 13.5px;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
    border-top: 1px dashed #e2ded5;
    padding-top: 8px;
  }

  /* Remedy & Mantra Banner */
  .remedy-mantra-banner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 20px;
    background: #101936;
    color: #ffffff;
    border-radius: 8px;
    padding: 24px;
    margin-bottom: 24px;
    border: 1px solid rgba(199, 145, 62, 0.35);
  }
  .rm-tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #c7913e;
    display: block;
    margin-bottom: 8px;
  }
  .rm-text {
    font-size: 14px;
    color: #ffffff;
    margin: 0 0 6px;
    line-height: 1.5;
  }
  .rm-text-hi {
    font-size: 13px;
    color: #cbd5e1;
    margin: 0;
    line-height: 1.5;
  }
  .mantra-sanskrit {
    font-family: "Noto Serif Devanagari", serif;
    font-size: 17px;
    font-weight: 600;
    color: #fce7b0;
    margin: 0 0 6px;
    letter-spacing: 0.5px;
  }
  .mantra-note {
    font-size: 11px;
    color: #94a3b8;
  }

  /* CTA Footer */
  .z-cta-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 20px;
    border-top: 1px solid #f0ece1;
    flex-wrap: wrap;
    gap: 16px;
  }
  .z-cta-footer p {
    margin: 0;
    font-size: 15px;
    color: #475569;
  }
  .btn-sm {
    padding: 10px 18px;
    font-size: 14px;
  }

  @media (max-width: 1024px) {
    .zodiac-selector-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (max-width: 768px) {
    .zodiac-selector-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .z-predictions-grid {
      grid-template-columns: 1fr;
    }
    .remedy-mantra-banner {
      grid-template-columns: 1fr;
    }
    .z-card-header {
      flex-direction: column;
      align-items: flex-start;
    }
    .z-lucky-stats {
      width: 100%;
      justify-content: space-between;
    }
  }
  @media (max-width: 480px) {
    .zodiac-selector-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
