---
import { getPanchangForDate, cities } from '../data/panchang';
import { site } from '../data/site';

const today = new Date();
const panchang = getPanchangForDate(today, 'delhi');
---

<section id="panchang" class="section panchang-section">
  <div class="wrap">
    <div class="section-header text-center">
      <p class="eyebrow-text">VEDIC CALENDAR · दैनिक पंचांग व शुभ मुहूर्त</p>
      <h2>Today's Panchang & Auspicious Timings</h2>
      <p class="section-desc">Traditional Five Angas (Tithi, Nakshatra, Yoga, Karana, Var) and daily planetary Muhurats.</p>
    </div>

    <!-- Date & Location Bar -->
    <div class="panchang-top-control">
      <div class="date-badge">
        <span class="cal-icon">🗓️</span>
        <div>
          <span class="curr-date" id="p-date-display">{panchang.dateFormatted}</span>
          <span class="curr-day">({panchang.dayOfWeek} · {panchang.dayOfWeekHi})</span>
        </div>
      </div>

      <div class="samvat-pills">
        <span class="samvat-tag">Vikram Samvat: <strong>{panchang.vikramSamvat}</strong></span>
        <span class="samvat-tag">Paksha: <strong>{panchang.paksha}</strong></span>
        <span class="samvat-tag">Ritu: <strong>{panchang.ritu}</strong></span>
      </div>

      <div class="city-picker">
        <label for="panchang-city-select" class="city-lbl">Location:</label>
        <select id="panchang-city-select" class="city-select">
          {cities.map((c) => (
            <option value={c.id} selected={c.id === 'delhi'}>{c.name}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Panchang Main Grid -->
    <div class="panchang-main-grid">
      <!-- 5 Core Elements Cards (Left Column) -->
      <div class="panchang-elements-col">
        <h3 class="col-heading">Five Essential Limbs (पंचांग अंग)</h3>

        <div class="elements-list">
          <!-- Tithi -->
          <div class="elem-card">
            <div class="elem-icon-box">🌕</div>
            <div class="elem-content">
              <div class="elem-meta">
                <span class="elem-title">TITHI (तिथि)</span>
                <span class="elem-time">Up to {panchang.tithi.till}</span>
              </div>
              <p class="elem-val">{panchang.tithi.name} ({panchang.tithi.nameHi})</p>
              <span class="elem-sub">Followed by {panchang.tithi.nextTithi}</span>
            </div>
          </div>

          <!-- Nakshatra -->
          <div class="elem-card">
            <div class="elem-icon-box">⭐</div>
            <div class="elem-content">
              <div class="elem-meta">
                <span class="elem-title">NAKSHATRA (नक्षत्र)</span>
                <span class="elem-time">Up to {panchang.nakshatra.till}</span>
              </div>
              <p class="elem-val">{panchang.nakshatra.name} ({panchang.nakshatra.nameHi})</p>
              <span class="elem-sub">Pada {panchang.nakshatra.pada} · Ruling Lord: <strong>{panchang.nakshatra.rulingPlanet}</strong></span>
            </div>
          </div>

          <!-- Yoga -->
          <div class="elem-card">
            <div class="elem-icon-box">🕉️</div>
            <div class="elem-content">
              <div class="elem-meta">
                <span class="elem-title">YOGA (योग)</span>
                <span class="elem-time">Up to {panchang.yoga.till}</span>
              </div>
              <p class="elem-val">{panchang.yoga.name} ({panchang.yoga.nameHi})</p>
              <span class="elem-sub">Vedic celestial combination</span>
            </div>
          </div>

          <!-- Karana -->
          <div class="elem-card">
            <div class="elem-icon-box">⏳</div>
            <div class="elem-content">
              <div class="elem-meta">
                <span class="elem-title">KARANA (करण)</span>
                <span class="elem-time">Up to {panchang.karana.till}</span>
              </div>
              <p class="elem-val">{panchang.karana.name}</p>
              <span class="elem-sub">Half-tithi operational energy</span>
            </div>
          </div>
        </div>

        <!-- Sun & Moon Rise Times -->
        <div class="sun-moon-strip">
          <div class="astro-time-item">
            <span class="at-icon">🌅</span>
            <div>
              <small>Sunrise (सूर्योदय)</small>
              <strong>{panchang.sunRise}</strong>
            </div>
          </div>
          <div class="astro-time-item">
            <span class="at-icon">🌇</span>
            <div>
              <small>Sunset (सूर्यास्त)</small>
              <strong>{panchang.sunSet}</strong>
            </div>
          </div>
          <div class="astro-time-item">
            <span class="at-icon">🌙</span>
            <div>
              <small>Moonrise (चंद्रोदय)</small>
              <strong>{panchang.moonRise}</strong>
            </div>
          </div>
        </div>
      </div>

      <!-- Muhurat & Auspicious/Inauspicious Timings (Right Column) -->
      <div class="panchang-muhurat-col">
        <!-- Shubh Muhurat Box -->
        <div class="muhurat-card shubh-card">
          <div class="m-card-header">
            <div class="m-header-left">
              <span class="m-badge m-shubh-badge">SHUBH TIMINGS · शुभ मुहूर्त</span>
              <h4>Auspicious Windows for New Work</h4>
            </div>
            <span class="m-star-icon">✨</span>
          </div>

          <div class="m-timings-grid">
            <div class="m-time-slot highlight-shubh">
              <div class="slot-info">
                <strong>Abhijit Muhurat (अभिजित मुहूर्त)</strong>
                <small>Most auspicious period of midday; removes hurdles</small>
              </div>
              <span class="slot-badge">{panchang.shubhMuhurat.abhijit.time}</span>
            </div>

            <div class="m-time-slot">
              <div class="slot-info">
                <strong>Brahma Muhurat (ब्रह्म मुहूर्त)</strong>
                <small>Ideal for meditation, prayers & study</small>
              </div>
              <span class="slot-badge-subtle">{panchang.shubhMuhurat.brahma.time}</span>
            </div>

            <div class="m-time-slot">
              <div class="slot-info">
                <strong>Amrit Kaal (अमृत काल)</strong>
                <small>Nectar period for auspicious rituals & contracts</small>
              </div>
              <span class="slot-badge-subtle">{panchang.shubhMuhurat.amritKaal.time}</span>
            </div>

            <div class="m-time-slot">
              <div class="slot-info">
                <strong>Vijaya Muhurat (विजय मुहूर्त)</strong>
                <small>Best for competitive matters, lawsuits & travel</small>
              </div>
              <span class="slot-badge-subtle">{panchang.shubhMuhurat.vijaya.time}</span>
            </div>
          </div>
        </div>

        <!-- Ashubh Kaal Box (Rahu Kaal Alert) -->
        <div class="muhurat-card ashubh-card">
          <div class="m-card-header">
            <div class="m-header-left">
              <span class="m-badge m-ashubh-badge">CAUTION · अशुभ समय (वर्जित काल)</span>
              <h4>Periods to Avoid for Major Beginnings</h4>
            </div>
            <span class="m-alert-icon">⚠️</span>
          </div>

          <div class="ashubh-list">
            <div class="ashubh-slot alert-rahu">
              <div class="ash-desc">
                <strong>Rahu Kaal (राहुकाल)</strong>
                <p>Avoid signing contracts, starting travel, or buying vehicles</p>
              </div>
              <span class="ash-time-badge">{panchang.ashubhMuhurat.rahuKaal.time}</span>
            </div>

            <div class="ashubh-slot">
              <div class="ash-desc">
                <strong>Yamaganda Kaal (यमगण्ड)</strong>
                <p>Avoid financial investments during this window</p>
              </div>
              <span class="ash-time-badge-subtle">{panchang.ashubhMuhurat.yamaganda.time}</span>
            </div>

            <div class="ashubh-slot">
              <div class="ash-desc">
                <strong>Gulika Kaal (गुलिक काल)</strong>
                <p>Avoid starting new legal undertakings</p>
              </div>
              <span class="ash-time-badge-subtle">{panchang.ashubhMuhurat.gulika.time}</span>
            </div>
          </div>
        </div>

        <!-- Custom Shubh Muhurat Guidance Card -->
        <div class="muhurat-cta-card">
          <div class="m-cta-text">
            <strong>Need a custom Shubh Muhurat for a major life milestone?</strong>
            <p>Griha Pravesh, Property Purchase, Marriage date, Naming ceremony or Business inauguration.</p>
          </div>
          <a href="#book" class="btn btn-gold btn-sm">
            Request Muhurat Consultation →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupPanchangInteractivity() {
    const citySelect = document.getElementById('panchang-city-select') as HTMLSelectElement;
    if (!citySelect) return;

    citySelect.addEventListener('change', () => {
      // City selection feedback
      const cityName = citySelect.options[citySelect.selectedIndex].text;
      const dateDisplay = document.getElementById('p-date-display');
      if (dateDisplay) {
        dateDisplay.setAttribute('title', `Panchang calibrated for ${cityName}`);
      }
    });
  }

  setupPanchangInteractivity();
  document.addEventListener('astro:page-load', setupPanchangInteractivity);
</script>

<style>
  .panchang-section {
    background: #ffffff;
    padding: 85px 0;
  }
  .text-center {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 40px;
  }

  /* Control Bar */
  .panchang-top-control {
    background: #faf8f2;
    border: 1px solid #e7e3d6;
    border-radius: 10px;
    padding: 16px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 36px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .date-badge {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .cal-icon {
    font-size: 26px;
  }
  .curr-date {
    font-family: "Playfair Display", serif;
    font-size: 19px;
    font-weight: 700;
    color: #18213d;
    display: block;
  }
  .curr-day {
    font-size: 13px;
    color: #64748b;
  }
  .samvat-pills {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .samvat-tag {
    font-size: 12px;
    background: #ffffff;
    border: 1px solid #dedbd1;
    padding: 6px 12px;
    border-radius: 20px;
    color: #475569;
  }
  .samvat-tag strong {
    color: #18213d;
  }
  .city-picker {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .city-lbl {
    font-size: 13px;
    font-weight: 600;
    color: #475569;
  }
  .city-select {
    padding: 6px 12px;
    border-radius: 6px;
    border: 1px solid #dedbd1;
    font-family: inherit;
    font-size: 13px;
    color: #18213d;
    background: #ffffff;
    cursor: pointer;
    outline: none;
  }
  .city-select:focus {
    border-color: #c7913e;
  }

  /* Grid Columns */
  .panchang-main-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 36px;
  }
  .col-heading {
    font-size: 20px;
    color: #18213d;
    margin: 0 0 18px;
  }

  /* 5 Elements */
  .elements-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 24px;
  }
  .elem-card {
    background: #fdfbf7;
    border: 1px solid #eae5d8;
    border-radius: 8px;
    padding: 16px 18px;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .elem-card:hover {
    border-color: #c7913e;
    transform: translateX(4px);
  }
  .elem-icon-box {
    font-size: 24px;
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: #ffffff;
    border: 1px solid #dedbd1;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .elem-content {
    flex-grow: 1;
  }
  .elem-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }
  .elem-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #a86f1e;
  }
  .elem-time {
    font-size: 11.5px;
    color: #64748b;
    background: #ffffff;
    border: 1px solid #e2ded5;
    padding: 2px 8px;
    border-radius: 4px;
  }
  .elem-val {
    font-size: 17px;
    font-weight: 700;
    color: #18213d;
    margin: 0 0 4px;
  }
  .elem-sub {
    font-size: 12.5px;
    color: #64748b;
  }

  /* Sun Moon Strip */
  .sun-moon-strip {
    background: #101936;
    color: #ffffff;
    border-radius: 8px;
    padding: 16px 20px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .astro-time-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .at-icon {
    font-size: 22px;
  }
  .astro-time-item small {
    display: block;
    font-size: 11px;
    color: #94a3b8;
  }
  .astro-time-item strong {
    font-size: 14px;
    color: #ffffff;
  }

  /* Muhurat Column */
  .panchang-muhurat-col {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .muhurat-card {
    border-radius: 10px;
    padding: 24px;
  }
  .shubh-card {
    background: #f4f8f4;
    border: 1px solid #c9e2c9;
  }
  .ashubh-card {
    background: #fff8f5;
    border: 1px solid #f6cfc4;
  }
  .m-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
  }
  .m-badge {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 3px 8px;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 6px;
  }
  .m-shubh-badge {
    background: #2e7d32;
    color: #ffffff;
  }
  .m-ashubh-badge {
    background: #c62828;
    color: #ffffff;
  }
  .m-card-header h4 {
    font-size: 18px;
    color: #18213d;
    margin: 0;
  }
  .m-star-icon, .m-alert-icon {
    font-size: 24px;
  }

  /* Timings */
  .m-timings-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .m-time-slot {
    background: #ffffff;
    border: 1px solid #dce8dc;
    border-radius: 6px;
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .m-time-slot.highlight-shubh {
    border: 1.5px solid #2e7d32;
    background: #ffffff;
    box-shadow: 0 3px 10px rgba(46, 125, 50, 0.08);
  }
  .slot-info strong {
    font-size: 14.5px;
    color: #18213d;
    display: block;
    margin-bottom: 2px;
  }
  .slot-info small {
    font-size: 12px;
    color: #64748b;
  }
  .slot-badge {
    background: #e8f5e9;
    color: #1b5e20;
    font-weight: 700;
    font-size: 13.5px;
    padding: 6px 12px;
    border-radius: 4px;
    border: 1px solid #c8e6c9;
  }
  .slot-badge-subtle {
    background: #f1f5f9;
    color: #334155;
    font-weight: 600;
    font-size: 13px;
    padding: 4px 10px;
    border-radius: 4px;
  }

  /* Ashubh Timings */
  .ashubh-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ashubh-slot {
    background: #ffffff;
    border: 1px solid #f2d8d2;
    border-radius: 6px;
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .ashubh-slot.alert-rahu {
    border: 1.5px solid #c62828;
    background: #fffafa;
  }
  .ash-desc strong {
    font-size: 14.5px;
    color: #991b1b;
    display: block;
    margin-bottom: 2px;
  }
  .ash-desc p {
    font-size: 12px;
    color: #64748b;
    margin: 0;
  }
  .ash-time-badge {
    background: #fee2e2;
    color: #991b1b;
    font-weight: 700;
    font-size: 13.5px;
    padding: 6px 12px;
    border-radius: 4px;
    border: 1px solid #fecaca;
    white-space: nowrap;
  }
  .ash-time-badge-subtle {
    background: #f8fafc;
    color: #475569;
    font-weight: 600;
    font-size: 13px;
    padding: 4px 10px;
    border-radius: 4px;
    white-space: nowrap;
  }

  /* Muhurat CTA */
  .muhurat-cta-card {
    background: #101936;
    color: #ffffff;
    border-radius: 8px;
    padding: 20px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .m-cta-text strong {
    font-size: 15px;
    color: #ffffff;
    display: block;
    margin-bottom: 4px;
  }
  .m-cta-text p {
    font-size: 13px;
    color: #cbd5e1;
    margin: 0;
  }

  @media (max-width: 900px) {
    .panchang-main-grid {
      grid-template-columns: 1fr;
    }
    .panchang-top-control {
      flex-direction: column;
      align-items: flex-start;
    }
    .sun-moon-strip {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
