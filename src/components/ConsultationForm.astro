  .ms-row span {
    color: #64748b;
  }
  .ms-row strong {
    color: #18213d;
    text-align: right;
  }
  .modal-cta-buttons {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 14px;
  }
  .modal-note {
    font-size: 12px;
    color: #94a3b8;
    margin: 0;
  }

  @media (max-width: 960px) {
    .booking-card-container {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 700px) {
    .booking-section { padding: 64px 0; }
    .booking-section .wrap { width: min(1120px, calc(100% - 28px)); }
    .form-group-grid,
    .form-group-grid.three-col {
      grid-template-columns: 1fr;
    }
    .form-card {
      padding: 24px 18px;
    }
  }
</style>
