      }
    }
  } as const;

  function initBookingForm() {
    const form = document.getElementById('consultation-form') as HTMLFormElement;
    const modal = document.getElementById('booking-success-modal') as HTMLElement;
    const closeModalBtn = document.getElementById('close-modal-btn') as HTMLButtonElement;
    const submitBtn = document.getElementById('submit-lead-btn') as HTMLButtonElement;
    const serviceSelect = document.getElementById('lead-service') as HTMLSelectElement;
    const birthDetails = document.getElementById('lead-birth-details') as HTMLElement;
    const dobInput = document.getElementById('lead-dob') as HTMLInputElement;
    const pobInput = document.getElementById('lead-pob') as HTMLInputElement;
    const questionInput = document.getElementById('lead-question') as HTMLTextAreaElement;
    const questionLabel = document.getElementById('lead-question-label') as HTMLLabelElement;
    const serviceGuidance = document.getElementById('service-guidance') as HTMLElement;
    const section = document.getElementById('book') as HTMLElement;

    if (!form) return;

    let currentLanguage: BookingLanguage = localStorage.getItem('click-jyotish-language') === 'hi' ? 'hi' : 'en';
    const setText = (selector: string, value: string) => {
      const element = section?.querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    };
    const setRequiredLabel = (selector: string, value: string) => {
      const element = section?.querySelector<HTMLElement>(selector);
      if (element) element.innerHTML = `${value} <span class="req">*</span>`;
    };
    const setOptionalLabel = (selector: string, value: string) => {
      const element = section?.querySelector<HTMLElement>(selector);
      if (element) element.innerHTML = `${value} <span class="optional-label">${currentLanguage === 'hi' ? 'वैकल्पिक' : 'Optional'}</span>`;
    };
    const setPerk = (index: number, title: string, description: string) => {
      const perk = section?.querySelectorAll<HTMLElement>('.perk-item')[index];
      const heading = perk?.querySelector<HTMLElement>('strong');
      const copy = perk?.querySelector<HTMLElement>('p');
      if (heading) heading.textContent = title;
      if (copy) copy.textContent = description;
    };

    const updateServiceFields = () => {
      const text = bookingText[currentLanguage];
      const service = serviceSelect?.value || '';
      const isVastu = service.includes('Vastu');
      const isPalmistry = service.includes('Palmistry');
      const needsBirthDetails = !isVastu && !isPalmistry;
      if (birthDetails) birthDetails.hidden = !needsBirthDetails;
      if (dobInput) dobInput.required = needsBirthDetails;
      if (pobInput) pobInput.required = needsBirthDetails;
      if (questionInput) questionInput.required = isVastu || isPalmistry;
      if (isVastu) {
        questionLabel.textContent = `${text.vastuQuestion} *`;
        questionInput.placeholder = currentLanguage === 'hi' ? 'उदाहरण: नोएडा में 3BHK फ्लैट, प्रवेश और बेडरूम से जुड़ी समस्या। ऑनलाइन चर्चा या साइट विज़िट भी बताएं।' : 'e.g., 3BHK flat in Noida, residential, entrance and bedroom concern. Mention online discussion or site visit.';
        serviceGuidance.textContent = text.vastuGuidance;
      } else if (isPalmistry) {
        questionLabel.textContent = `${text.palmistryQuestion} *`;
        questionInput.placeholder = currentLanguage === 'hi' ? 'अपना मुख्य प्रश्न लिखें। व्यक्तिगत पुष्टि के बाद दोनों हथेलियों की साफ़ तस्वीरें मांगी जा सकती हैं।' : 'Write your main question. Clear photos of both palms can be requested after personal confirmation.';
        serviceGuidance.textContent = text.palmistryGuidance;
      } else {
        questionLabel.textContent = text.question;
        questionInput.placeholder = currentLanguage === 'hi' ? 'उदाहरण: नौकरी में पदोन्नति का समय, व्यवसाय साझेदारी या संबंध से जुड़ा प्रश्न।' : 'e.g., Job promotion timing, business partnership or relationship question.';
        serviceGuidance.textContent = text.kundaliGuidance;
      }
    };

    const applyBookingLanguage = (language: BookingLanguage) => {
      currentLanguage = language;
      const text = bookingText[language];
      setText('.eyebrow-text-light', text.eyebrow);
      setText('.sidebar-header h2', text.sidebarTitle);
      setText('.sidebar-lead', text.sidebarLead);
      setText('.practitioner-mini-card span', text.practitioner);
      setPerk(0, text.privateTitle, text.privateText);
      setPerk(1, text.callTitle, text.callText);
      setPerk(2, text.confirmationTitle, text.confirmationText);
      setText('.calendar-choice strong', text.calendarTitle);
      setText('.calendar-choice small', text.calendarText);
      setText('.sidebar-contact-info > span', text.help);
      setText('.form-header h3', text.title);
      setText('.form-header p', text.intro);
      setRequiredLabel('label[for="lead-name"]', text.name);
      setRequiredLabel('label[for="lead-phone"]', text.phone);
      setOptionalLabel('label[for="lead-email"]', text.email);
      setRequiredLabel('label[for="lead-service"]', text.service);
      setText('.form-subheading span', text.birth);
      setRequiredLabel('label[for="lead-dob"]', text.dob);
      setText('label[for="lead-tob"]', text.tob);
      setRequiredLabel('label[for="lead-pob"]', text.pob);
      setText('label[for="lead-tob-unknown"]', text.unknownTime);
      setRequiredLabel('label[for="lead-language"]', text.language);
      setText('label[for="lead-slot"]', text.slot);
      setRequiredLabel('label[for="lead-consent"]', text.consent);
      setText('#submit-lead-btn span', text.submit);
      setText('.submit-disclaimer', text.disclaimer);
      setText('#booking-modal-title', text.modalTitle);
      setText('.modal-msg-before', text.modalGreeting);
      setText('.modal-msg-after', text.modalAfter);
      const summaryLabels = section?.querySelectorAll<HTMLElement>('.modal-summary-box .ms-row > span:first-child');
      if (summaryLabels?.[0]) summaryLabels[0].textContent = text.modalService;
      if (summaryLabels?.[1]) summaryLabels[1].textContent = text.modalFee;
      if (summaryLabels?.[2]) summaryLabels[2].textContent = text.modalBirth;
      setText('#modal-wa-btn', text.modalWhatsapp);
      setText('.modal-cta-buttons a.btn-outline', text.modalCalendar);
      setText('#close-modal-btn', text.modalClose);
      setText('.modal-note', text.modalNote);

      const icons: Record<string, string> = { kundali: '✨', career: '💼', marriage: '💍', vastu: '🏡', palmistry: '✋' };
      Array.from(serviceSelect?.options || []).forEach((option) => {
        const id = option.dataset.serviceId as keyof typeof text.serviceNames | undefined;
        if (!id) return;
        option.textContent = `${icons[id]} ${text.serviceNames[id]} — ${option.dataset.price}`;
      });
      const languageOptions = Array.from(document.querySelectorAll('#lead-language option'));
      const languageLabels = language === 'hi' ? ['हिंदी', 'अंग्रेज़ी', 'हिंदी + अंग्रेज़ी'] : ['Hindi (हिंदी)', 'English', 'Bilingual (Hindi + English)'];
      languageOptions.forEach((option, index) => { option.textContent = languageLabels[index] || option.textContent; });
      const slotOptions = Array.from(document.querySelectorAll('#lead-slot option'));
      const slotLabels = language === 'hi' ? ['सुबह (10:00 AM - 01:00 PM)', 'दोपहर (02:00 PM - 05:00 PM)', 'शाम (06:00 PM - 09:00 PM)', 'सबसे पहला उपलब्ध स्लॉट'] : ['Morning (10:00 AM - 01:00 PM)', 'Afternoon (02:00 PM - 05:00 PM)', 'Evening (06:00 PM - 09:00 PM)', 'Earliest Available Slot'];
      slotOptions.forEach((option, index) => { option.textContent = slotLabels[index] || option.textContent; });
      const nameInput = document.getElementById('lead-name') as HTMLInputElement | null;
      const phoneInput = document.getElementById('lead-phone') as HTMLInputElement | null;
      const emailInput = document.getElementById('lead-email') as HTMLInputElement | null;
      const pobTextInput = document.getElementById('lead-pob') as HTMLInputElement | null;
      if (nameInput) nameInput.placeholder = language === 'hi' ? 'उदाहरण: राहुल शर्मा' : 'e.g. Rahul Sharma';
      if (phoneInput) phoneInput.placeholder = language === 'hi' ? 'उदाहरण: 9876543210 (कंट्री कोड के साथ)' : 'e.g. 9876543210 (with country code)';
      if (emailInput) emailInput.placeholder = language === 'hi' ? 'उदाहरण: rahul.sharma@gmail.com' : 'e.g. rahul.sharma@gmail.com';
      if (pobTextInput) pobTextInput.placeholder = language === 'hi' ? 'उदाहरण: नई दिल्ली, भारत' : 'e.g. New Delhi, India';
      updateServiceFields();
    };
    const requestedService = new URLSearchParams(window.location.search).get('service');
    const serviceLookup: Record<string, string> = {
      kundali: 'Vedic Kundali & Dasha Analysis',
      career: 'Career, Job Change & Business Timing',
      marriage: 'Kundali Milan & Relationship Harmony',
      vastu: 'Home & Workplace Vastu Shastra',
      palmistry: 'Palmistry & Hand Analysis (Hastarekha)'
    };
    if (requestedService && serviceLookup[requestedService] && serviceSelect) {
      serviceSelect.value = serviceLookup[requestedService];
    }
    serviceSelect?.addEventListener('change', updateServiceFields);
    applyBookingLanguage(currentLanguage);
    if (!form.dataset.languageInitialised) {
      form.dataset.languageInitialised = 'true';
      document.addEventListener('click-jyotish-language-change', ((event: Event) => {
        const language = (event as CustomEvent<{ language?: BookingLanguage }>).detail?.language;
        applyBookingLanguage(language === 'hi' ? 'hi' : 'en');
      }) as EventListener);
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = `<span>${bookingText[currentLanguage].processing}</span>`;
      }

      const formData = new FormData(form);
      const name = formData.get('name')?.toString().trim() || 'Client';
      const phone = formData.get('phone')?.toString().trim() || '';
      const email = formData.get('email')?.toString().trim() || '';
      const dob = formData.get('dob')?.toString() || '';
      const tob = formData.get('tob')?.toString() || 'Not specified';
      const pob = formData.get('pob')?.toString().trim() || '';
      const tobUnknown = formData.get('tobUnknown') ? 'Yes (Unknown TOB)' : 'No';
      const service = formData.get('service')?.toString() || 'Vedic Astrology Consultation';
      const language = formData.get('language')?.toString() || 'Hindi';
      const preferredSlot = formData.get('preferredSlot')?.toString() || 'Evening';
      const question = formData.get('question')?.toString().trim() || 'General Kundali Reading';
      const attribution = (() => {
        const params = new URLSearchParams(window.location.search);
        const source = params.get('utm_source');
        const medium = params.get('utm_medium');
        const campaign = params.get('utm_campaign');
        const content = params.get('utm_content');
        const landing = window.location.pathname || '/';
        const storageKey = 'click-jyotish-lead-attribution';
        const remember = (value) => {
          try { window.sessionStorage.setItem(storageKey, value); }
          catch { /* Tracking should never block a consultation request. */ }
        };
        const recalled = () => {
          try { return window.sessionStorage.getItem(storageKey); }
          catch { return null; }
        };

        if (source) {
          const value = `UTM: ${[source, medium, campaign, content].filter(Boolean).join(' / ')}`;
          remember(value);
          return `${value} · ${landing}`;
        }
        if (params.get('gclid')) {
          const value = 'Google Ads';
          remember(value);
          return `${value} · ${landing}`;
        }
        const previousSource = recalled();
        if (previousSource) return `${previousSource} · ${landing}`;
        if (document.referrer) {
          try {
            const referrer = new URL(document.referrer);
            if (referrer.origin !== window.location.origin) {
              const value = `Referral: ${referrer.hostname}`;
              remember(value);
              return `${value} · ${landing}`;
            }
          }
          catch { /* Ignore an invalid referrer. */ }
        }
        return `Direct · ${landing}`;
      })();

      const leadPayload = {
        timestamp: new Date().toISOString(),
        name,
        phone,
        email,
        dob,
        tob: tobUnknown === 'Yes (Unknown TOB)' ? 'Unknown (Prashna/Palmistry)' : tob,
        pob,
        service,
        language,
        preferredSlot,
        question,
        source: attribution
      };

      // Save centrally to the private Click Jyotish lead inbox.
      let inboxSaved = false;
      try {
        const response = await fetch('/api/leads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(leadPayload)
        });

        if (!response.ok) throw new Error('Lead inbox could not save the request');
        inboxSaved = true;
      } catch (err) {
        console.error('Lead save error:', err);
      }

      // Format WhatsApp Deep-Link Message
      const waText = 
`*Namaste Deepak,* 🙏
I would like to enquire about *${service}*.

*Consultation Details:*
• *Name:* ${name}
• *Phone:* ${phone}
${email ? `• *Email:* ${email}\n` : ''}• *Date of Birth:* ${dob}
• *Time of Birth:* ${leadPayload.tob}
• *Place of Birth:* ${pob}
• *Language:* ${language}
• *Preferred Slot:* ${preferredSlot}

*My Query / Concern:*
"${question}"

_Please let me know the available time slot and payment details. Thank you._`;

      const astrologerPhone = '917669655530';
      const waUrl = `https://wa.me/${astrologerPhone}?text=${encodeURIComponent(waText)}`;

      // Update and show success modal
      const modalName = document.getElementById('modal-client-name');
      const modalService = document.getElementById('modal-service-name');
      const modalBirth = document.getElementById('modal-birth-info');
      const modalWaBtn = document.getElementById('modal-wa-btn') as HTMLAnchorElement;
      const modalPrice = document.getElementById('modal-price') as HTMLElement;
      const modalIcon = document.getElementById('booking-modal-icon');
      const modalTitle = document.getElementById('booking-modal-title');
      const modalAfter = document.querySelector('.modal-msg-after');
      const modalNote = document.querySelector('.modal-note');
      const text = bookingText[currentLanguage];

      if (modalName) modalName.textContent = name;
      if (modalService) modalService.textContent = service;
      if (modalBirth) modalBirth.textContent = `${dob} | ${leadPayload.tob} | ${pob}`;
      if (modalIcon) modalIcon.textContent = inboxSaved ? '✅' : '💬';
      if (modalTitle) modalTitle.textContent = inboxSaved ? text.modalTitle : text.modalFallbackTitle;
      if (modalAfter) modalAfter.textContent = inboxSaved ? text.modalAfter : text.modalFallbackAfter;
      if (modalNote) modalNote.textContent = inboxSaved ? text.modalNote : text.modalFallbackNote;
      if (modalPrice) {
        const selectedPrice = serviceSelect?.selectedOptions[0]?.dataset.price || '';
        modalPrice.textContent = selectedPrice === 'Custom quote' ? 'Custom quote after review' : `${selectedPrice} · 15-minute online consultation`;
      }
      if (modalWaBtn) modalWaBtn.href = waUrl;

      if (modal) {
        modal.classList.add('active');
        modal.setAttribute('aria-hidden', 'false');
      }

      // Automatically launch WhatsApp in new tab
      window.open(waUrl, '_blank');

      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<span>${bookingText[currentLanguage].submit}</span>`;
      }
    });

    if (closeModalBtn && modal) {
      closeModalBtn.addEventListener('click', () => {
        modal.classList.remove('active');
        modal.setAttribute('aria-hidden', 'true');
        form.reset();
      });
    }

    const overlay = modal?.querySelector('.modal-overlay');
    if (overlay && modal) {
      overlay.addEventListener('click', () => {
        modal.classList.remove('active');
        modal.setAttribute('aria-hidden', 'true');
      });
    }
  }

  initBookingForm();
  document.addEventListener('astro:page-load', initBookingForm);
</script>

<style>
  .booking-section {
    background: #101936;
    color: #ffffff;
    padding: 90px 0;
  }
  .booking-card-container {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 48px;
    align-items: flex-start;
  }
  .booking-sidebar,
  .booking-form-wrapper { min-width: 0; }

  /* Sidebar Left */
  .eyebrow-text-light {
    font-size: 11.5px;
    letter-spacing: 2px;
    color: #c7913e;
    font-weight: 700;
    margin-bottom: 12px;
    display: block;
  }
  .sidebar-header h2 {
    font-size: 38px;
    color: #ffffff;
    margin: 0 0 16px;
  }
  .sidebar-lead {
    font-size: 16.5px;
