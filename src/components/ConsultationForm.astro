    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
  }
  .mini-avatar {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 24%;
    border: 2px solid #c7913e;
  }
  .practitioner-mini-card strong {
    display: block;
    font-size: 16px;
    color: #ffffff;
  }
  .practitioner-mini-card span {
    font-size: 13px;
    color: #cbd5e1;
    display: block;
  }
  .practitioner-mini-card small {
    font-size: 12px;
    color: #94a3b8;
  }

  /* Trust Perks */
  .trust-perks {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 32px;
  }
  .perk-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .perk-item .p-icon {
    font-size: 20px;
    background: rgba(199, 145, 62, 0.18);
    border: 1px solid rgba(199, 145, 62, 0.35);
    width: 36px;
    height: 36px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .perk-item strong {
    font-size: 14.5px;
    color: #ffffff;
    display: block;
    margin-bottom: 2px;
  }
  .perk-item p {
    font-size: 13px;
    color: #94a3b8;
    margin: 0;
    line-height: 1.5;
  }
  .calendar-choice {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 13px;
    margin: 0 0 24px;
    color: #ffffff;
    text-decoration: none;
    border: 1px solid rgba(199, 145, 62, 0.5);
    border-radius: 8px;
    background: rgba(199, 145, 62, 0.1);
  }
  .calendar-choice:hover { background: rgba(199, 145, 62, 0.2); }
  .calendar-choice span:first-child { font-size: 20px; }
  .calendar-choice span:nth-child(2) { flex: 1; }
  .calendar-choice strong, .calendar-choice small { display: block; }
  .calendar-choice strong { font-size: 13px; }
  .calendar-choice small { margin-top: 2px; color: #cbd5e1; font-size: 12px; }
  .calendar-choice b { color: #e5b45f; font-size: 18px; }

  /* Direct Phone Link */
  .sidebar-contact-info {
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 13.5px;
    color: #94a3b8;
  }
  .phone-link {
    display: block;
    color: #c7913e;
    font-weight: 700;
    font-size: 16px;
    margin-top: 4px;
    text-decoration: none;
  }

  /* Form Card Right */
  .form-card {
    width: 100%;
    min-width: 0;
    background: #ffffff;
    color: #18213d;
    border-radius: 12px;
    padding: 28px 30px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
  }
  .form-header {
    margin-bottom: 18px;
    border-bottom: 1px solid #f0ece1;
    padding-bottom: 12px;
  }
  .form-header h3 {
    font-size: 23px;
    color: #18213d;
    margin: 0 0 6px;
  }
  .form-header p {
    font-size: 14px;
    color: #64748b;
    margin: 0;
  }
  .form-header p a { color: #9a651b; font-weight: 700; }
  .consultation-choice { padding: 12px; border: 1px solid #eadcc0; border-radius: 8px; background: #fffaf0; }
  .service-guidance { margin: 7px 0 0; color: #667085; font-size: 12.5px; line-height: 1.4; }

  /* Form Fields */
  .astro-lead-form {
    display: flex;
    flex-direction: column;
    gap: 13px;
  }
  .form-group-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 13px;
    min-width: 0;
  }
  .form-group-grid.three-col {
    grid-template-columns: repeat(3, 1fr);
  }
  .input-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .input-field label {
    font-size: 12.5px;
    font-weight: 700;
    color: #334155;
    letter-spacing: 0.3px;
  }
  .req {
    color: #dc2626;
  }
  .optional-label {
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
  }
  .input-field input,
  .input-field select,
  .input-field textarea {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    padding: 10px 12px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 14px;
    font-family: inherit;
    color: #18213d;
    background: #ffffff;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .input-field select { overflow: hidden; text-overflow: ellipsis; }
  .input-field label,
  .service-guidance,
  .checkbox-field label { overflow-wrap: anywhere; }
  .consultation-choice,
  #lead-birth-details { min-width: 0; }
  .input-field input:focus,
  .input-field select:focus,
  .input-field textarea:focus {
    border-color: #c7913e;
    box-shadow: 0 0 0 3px rgba(199, 145, 62, 0.15);
  }
  .form-subheading {
    margin-top: 2px;
    padding-top: 8px;
    border-top: 1px dashed #e2e8f0;
  }
  .form-subheading span {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    color: #a86f1e;
  }
  .checkbox-field {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .checkbox-field input {
    accent-color: #c7913e;
    width: 16px;
    height: 16px;
    cursor: pointer;
  }
  .checkbox-field label {
    font-size: 12.5px;
    color: #64748b;
    cursor: pointer;
  }

  /* Submit Button */
  .form-submit-container {
    margin-top: 4px;
  }
  .btn-block {
    width: 100%;
    padding: 15px;
    font-size: 16px;
    font-weight: 700;
  }
  .submit-disclaimer {
    font-size: 11.5px;
    color: #94a3b8;
    text-align: center;
    margin: 10px 0 0;
    line-height: 1.4;
  }

  /* Modal */
  .booking-modal {
    position: fixed;
    inset: 0;
    z-index: 999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .booking-modal.active {
    display: flex;
  }
  .modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(16, 25, 54, 0.85);
    backdrop-filter: blur(4px);
  }
  .modal-card {
    position: relative;
    background: #ffffff;
    color: #18213d;
    border-radius: 12px;
    padding: 36px 30px;
    width: min(520px, 100%);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.35);
    text-align: center;
    z-index: 2;
    animation: modalPop 0.25s ease-out;
  }
  @keyframes modalPop {
    from { opacity: 0; transform: scale(0.92); }
    to { opacity: 1; transform: scale(1); }
  }
  .modal-icon {
    font-size: 44px;
    margin-bottom: 12px;
  }
  .modal-card h3 {
    font-size: 24px;
    color: #18213d;
    margin: 0 0 8px;
  }
  .modal-msg {
    font-size: 14.5px;
    color: #475569;
    margin: 0 0 20px;
  }
  .modal-summary-box {
    background: #faf8f2;
    border: 1px solid #e8e3d5;
