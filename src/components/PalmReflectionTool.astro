---
import { site } from '../data/site';
---

<section class="palm-tool" aria-labelledby="palm-tool-title">
  <div class="wrap palm-tool-grid">
    <div class="palm-tool-copy">
      <p class="palm-tool-eyebrow" data-copy="eyebrow">FREE PALM REFLECTION · हस्तरेखा</p>
      <h1 id="palm-tool-title" data-copy="title">A thoughtful look at your palm</h1>
      <p class="palm-tool-intro" data-copy="intro">Upload a clear palm photo for an instant, general Hastarekha reflection. It is a spiritual, entertainment-style perspective—not a certain prediction or professional advice.</p>
      <div class="palm-tool-privacy"><span aria-hidden="true">🔒</span><p data-copy="privacy">Click Jyotish does not store these photos. They are resized in your browser and sent only to create this one response.</p></div>
      <div class="palm-tool-guidance">
        <h2 data-copy="tipsTitle">For a useful photo</h2>
        <ul>
          <li data-copy="tip1">Use your active (dominant) palm, open and facing the camera.</li>
          <li data-copy="tip2">Use daylight; keep the whole palm and fingers in focus.</li>
          <li data-copy="tip3">Avoid filters, shadows, jewellery and blurred photos.</li>
        </ul>
      </div>
      <div class="palm-tool-human">
        <strong data-copy="humanTitle">Want a personal reading?</strong>
        <p data-copy="humanCopy">A photo cannot replace a conversation. Deepak can review both palms and your specific question in a private consultation.</p>
        <a href="/?service=palmistry&utm_source=palm-reflection&utm_medium=website&utm_campaign=personal-reading#book" data-copy="humanAction">Request Palmistry consultation →</a>
      </div>
    </div>

    <div class="palm-tool-panel">
      <form id="palm-reflection-form" novalidate>
        <section class="palm-mobile-camera-guide" aria-label="Mobile palm photo guide">
          <p class="palm-camera-eyebrow" data-copy="mobileGuideEyebrow">MOBILE PHOTO GUIDE</p>
          <ol>
            <li><span>1</span><div><strong data-copy="mobileStepOneTitle">Open camera</strong><small data-copy="mobileStepOneCopy">Use the button below.</small></div></li>
            <li><span>2</span><div><strong data-copy="mobileStepTwoTitle">Show active palm</strong><small data-copy="mobileStepTwoCopy">Keep the full open palm in daylight.</small></div></li>
            <li><span>3</span><div><strong data-copy="mobileStepThreeTitle">Take one clear photo</strong><small data-copy="mobileStepThreeCopy">Then tick consent and receive your reflection.</small></div></li>
          </ol>
          <button id="palm-camera-trigger" class="palm-camera-trigger" type="button"><span aria-hidden="true">📷</span><span data-copy="openCamera">Open camera</span></button>
          <p class="palm-camera-note" data-copy="cameraNote">Your phone may offer Camera or Photo Library—choose Camera for a new photo.</p>
        </section>
        <label class="palm-upload" for="palm-right-photo">
          <span class="palm-upload-icon" aria-hidden="true">🖐️</span>
          <span class="palm-upload-title" data-copy="rightLabel">Active / dominant palm photo <em>required</em></span>
          <span class="palm-upload-detail" data-copy="rightDetail">Tap to choose a JPG, PNG or WebP image</span>
          <input id="palm-right-photo" name="rightPalm" type="file" accept="image/jpeg,image/png,image/webp" capture="environment" required />
        </label>
        <p id="palm-right-name" class="palm-file-name" aria-live="polite"></p>

        <label class="palm-consent"><input id="palm-consent" type="checkbox" required /><span data-copy="consent">I consent to sending these photos to Google Gemini for this one general palmistry reflection. I understand free-tier processing may use submitted content to improve the provider’s products.</span></label>
        <input id="palm-website" class="palm-honeypot" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button id="palm-submit" type="submit"><span data-copy="submit">Get my free palm reflection</span><span aria-hidden="true">→</span></button>
        <p class="palm-tool-disclaimer" data-copy="disclaimer">Please do not upload documents, another person’s hand without permission, or any sensitive image. This tool cannot assess health, lifespan, pregnancy, legal matters or financial outcomes.</p>
        <p id="palm-form-status" class="palm-form-status" role="status" aria-live="polite"></p>
      </form>

      <section id="palm-result" class="palm-result" hidden aria-live="polite">
        <p class="palm-result-eyebrow" data-copy="resultEyebrow">YOUR GENERAL PALM REFLECTION</p>
        <h2 id="palm-result-title"></h2>
        <div class="palm-result-sections">
          <article class="palm-result-section palm-result-summary"><span class="palm-result-number">01</span><div><h3 data-copy="summaryLabel">Short summary</h3><p id="palm-result-summary"></p></div></article>
          <article class="palm-result-section"><span class="palm-result-number">02</span><div><h3 data-copy="patternsLabel">Visible patterns</h3><p id="palm-result-patterns"></p></div></article>
          <article class="palm-result-section"><span class="palm-result-number">03</span><div><h3 data-copy="reflectionLabel">Practical reflection</h3><p id="palm-result-reflection"></p></div></article>
        </div>
        <div class="palm-result-actions"><a href="/?service=palmistry&utm_source=palm-reflection-result&utm_medium=website&utm_campaign=personal-reading#book" data-copy="resultAction">Request a personal reading</a><button id="palm-try-again" type="button" data-copy="tryAgain">Try another photo</button></div>
      </section>
    </div>
  </div>
</section>

<script>
  const copy = {
    en: {
      eyebrow: 'FREE PALM REFLECTION · हस्तरेखा', title: 'A thoughtful look at your palm',
      intro: 'Upload a clear palm photo for an instant, general Hastarekha reflection. It is a spiritual, entertainment-style perspective—not a certain prediction or professional advice.',
      privacy: 'Click Jyotish does not store these photos. They are resized in your browser and sent only to create this one response.',
      tipsTitle: 'For a useful photo', tip1: 'Use your active (dominant) palm, open and facing the camera.', tip2: 'Use daylight; keep the whole palm and fingers in focus.', tip3: 'Avoid filters, shadows, jewellery and blurred photos.',
      humanTitle: 'Want a personal reading?', humanCopy: 'A photo cannot replace a conversation. Deepak can review both palms and your specific question in a private consultation.', humanAction: 'Request Palmistry consultation →',
      rightLabel: 'Active / dominant palm photo <em>required</em>', rightDetail: 'Tap to choose a JPG, PNG or WebP image',
      mobileGuideEyebrow: 'MOBILE PHOTO GUIDE', mobileStepOneTitle: 'Open camera', mobileStepOneCopy: 'Use the button below.', mobileStepTwoTitle: 'Show active palm', mobileStepTwoCopy: 'Keep the full open palm in daylight.', mobileStepThreeTitle: 'Take one clear photo', mobileStepThreeCopy: 'Then tick consent and receive your reflection.', openCamera: 'Open camera', cameraNote: 'Your phone may offer Camera or Photo Library—choose Camera for a new photo.',
      consent: 'I consent to sending these photos to Google Gemini for this one general palmistry reflection. I understand free-tier processing may use submitted content to improve the provider’s products.', submit: 'Get my free palm reflection',
      disclaimer: 'Please do not upload documents, another person’s hand without permission, or any sensitive image. This tool cannot assess health, lifespan, pregnancy, legal matters or financial outcomes.',
      preparing: 'Preparing your photo…', thinking: 'Reading your palm thoughtfully…', missing: 'Please choose a clear photo of your active palm and give consent.', tooLarge: 'Please use a photo under 8 MB.', unavailable: 'The free palm reflection is temporarily unavailable. Please try again later or request a personal reading.', resultEyebrow: 'YOUR GENERAL PALM REFLECTION', resultTitle: 'A gentle reflection', summaryLabel: 'Short summary', patternsLabel: 'Visible patterns', reflectionLabel: 'Practical reflection', patternsFallback: 'Every palm is individual; line clarity and hand shape are best considered as a broad starting point.', reflectionFallback: 'Use this as a gentle moment for self-awareness, not as a fixed prediction.', tryAgain: 'Try another photo', resultAction: 'Request a personal reading', noHand: 'I could not clearly see an open palm. Please try a brighter, sharper photo with the whole palm visible.'
    },
    hi: {
      eyebrow: 'निःशुल्क हस्तरेखा चिंतन · HASTAREKHA', title: 'अपनी हथेली को सोच-समझकर जानें',
      intro: 'एक साफ़ हथेली की तस्वीर अपलोड करें और सामान्य हस्तरेखा चिंतन पाएं। यह आध्यात्मिक व मनोरंजन-आधारित दृष्टि है—निश्चित भविष्यवाणी या पेशेवर सलाह नहीं।',
      privacy: 'Click Jyotish इन तस्वीरों को स्टोर नहीं करता। इन्हें आपके ब्राउज़र में छोटा किया जाता है और केवल एक उत्तर बनाने के लिए भेजा जाता है।',
      tipsTitle: 'साफ़ फोटो के लिए', tip1: 'अपनी सक्रिय (जिस हाथ से आप लिखते हैं) हथेली खोलकर कैमरे की ओर रखें।', tip2: 'दिन की रोशनी में पूरी हथेली और उंगलियाँ फोकस में रखें।', tip3: 'फिल्टर, छाया, आभूषण और धुंधली तस्वीर से बचें।',
      humanTitle: 'व्यक्तिगत रीडिंग चाहिए?', humanCopy: 'तस्वीर बातचीत का विकल्प नहीं है। दीपक आपकी दोनों हथेलियाँ और आपका विशेष प्रश्न निजी परामर्श में देख सकते हैं।', humanAction: 'हस्तरेखा परामर्श का अनुरोध करें →',
      rightLabel: 'सक्रिय हथेली की फोटो <em>आवश्यक</em>', rightDetail: 'JPG, PNG या WebP फोटो चुनने के लिए टैप करें',
      mobileGuideEyebrow: 'मोबाइल फोटो गाइड', mobileStepOneTitle: 'कैमरा खोलें', mobileStepOneCopy: 'नीचे दिए बटन को टैप करें।', mobileStepTwoTitle: 'सक्रिय हथेली दिखाएं', mobileStepTwoCopy: 'दिन की रोशनी में खुली हथेली पूरी दिखे।', mobileStepThreeTitle: 'एक साफ़ फोटो लें', mobileStepThreeCopy: 'फिर सहमति दें और अपना चिंतन पाएं।', openCamera: 'कैमरा खोलें', cameraNote: 'आपका फोन कैमरा या फोटो लाइब्रेरी दिखा सकता है—नई तस्वीर के लिए कैमरा चुनें।',
      consent: 'मैं इस सामान्य हस्तरेखा चिंतन के लिए इन तस्वीरों को Google Gemini को भेजने की सहमति देता/देती हूँ। मैं समझता/समझती हूँ कि मुफ्त स्तर पर भेजी गई सामग्री का उपयोग प्रदाता अपने उत्पाद सुधारने में कर सकता है।', submit: 'मेरा निःशुल्क हस्तरेखा चिंतन पाएं',
      disclaimer: 'दस्तावेज़, बिना अनुमति किसी अन्य व्यक्ति के हाथ की फोटो या संवेदनशील तस्वीर अपलोड न करें। यह टूल स्वास्थ्य, आयु, गर्भावस्था, कानूनी मामलों या वित्तीय परिणामों का आकलन नहीं कर सकता।',
      preparing: 'आपकी फोटो तैयार हो रही है…', thinking: 'हथेली को ध्यान से देखा जा रहा है…', missing: 'कृपया अपनी सक्रिय हथेली की साफ़ फोटो चुनें और सहमति दें।', tooLarge: 'कृपया 8 MB से छोटी फोटो चुनें।', unavailable: 'निःशुल्क हस्तरेखा चिंतन अभी उपलब्ध नहीं है। बाद में प्रयास करें या व्यक्तिगत रीडिंग का अनुरोध करें।', resultEyebrow: 'आपका सामान्य हस्तरेखा चिंतन', resultTitle: 'एक सौम्य दृष्टि', summaryLabel: 'संक्षिप्त सार', patternsLabel: 'दिखाई देने वाले संकेत', reflectionLabel: 'व्यावहारिक चिंतन', patternsFallback: 'हर हथेली अलग होती है; रेखाओं की स्पष्टता और हाथ के आकार को एक सामान्य शुरुआत की तरह देखना बेहतर है।', reflectionFallback: 'इसे निश्चित भविष्यवाणी नहीं, बल्कि आत्म-चिंतन के एक सौम्य अवसर की तरह लें।', tryAgain: 'दूसरी फोटो आज़माएं', resultAction: 'व्यक्तिगत रीडिंग का अनुरोध करें', noHand: 'खुली हथेली साफ़ दिखाई नहीं दे रही है। पूरी हथेली के साथ अधिक रोशनी वाली स्पष्ट फोटो फिर से आज़माएं।'
    }
  } as const;

  type Language = keyof typeof copy;
  const limitBytes = 8 * 1024 * 1024;

  function setupPalmReflection() {
    const form = document.getElementById('palm-reflection-form') as HTMLFormElement | null;
    if (!form || form.dataset.ready === 'true') return;
    form.dataset.ready = 'true';
    const right = document.getElementById('palm-right-photo') as HTMLInputElement;
    const rightName = document.getElementById('palm-right-name') as HTMLElement;
    const consent = document.getElementById('palm-consent') as HTMLInputElement;
    const honeypot = document.getElementById('palm-website') as HTMLInputElement;
    const status = document.getElementById('palm-form-status') as HTMLElement;
    const submit = document.getElementById('palm-submit') as HTMLButtonElement;
    const cameraTrigger = document.getElementById('palm-camera-trigger') as HTMLButtonElement | null;
    const result = document.getElementById('palm-result') as HTMLElement;
    const resultTitle = document.getElementById('palm-result-title') as HTMLElement;
    const resultSummary = document.getElementById('palm-result-summary') as HTMLElement;
    const resultPatterns = document.getElementById('palm-result-patterns') as HTMLElement;
    const resultReflection = document.getElementById('palm-result-reflection') as HTMLElement;
    let language: Language = localStorage.getItem('click-jyotish-language') === 'hi' ? 'hi' : 'en';

    const text = () => copy[language];
    const fileName = (file: File | undefined) => file ? `${file.name} · ${Math.ceil(file.size / 1024)} KB` : '';
    const updateFileName = (input: HTMLInputElement, output: HTMLElement) => { output.textContent = fileName(input.files?.[0]); };
    right.addEventListener('change', () => updateFileName(right, rightName));
    cameraTrigger?.addEventListener('click', () => right.click());

    const setLanguage = (next: Language) => {
      language = next;
      document.querySelectorAll<HTMLElement>('[data-copy]').forEach((element) => {
        const key = element.dataset.copy as keyof typeof copy.en | undefined;
        if (!key) return;
        const value = copy[language][key];
        if (element.matches('.palm-upload-title')) element.innerHTML = value as string;
        else element.textContent = value as string;
      });
    };

    type PalmSections = { summary?: string; patterns?: string; reflection?: string };
    type PalmResponse = { title?: string; reading?: string; sections?: PalmSections };
    const showResult = (data: PalmResponse) => {
      resultTitle.textContent = data.title || text().resultTitle;
      resultSummary.textContent = data.sections?.summary || data.reading || text().unavailable;
      resultPatterns.textContent = data.sections?.patterns || text().patternsFallback;
      resultReflection.textContent = data.sections?.reflection || text().reflectionFallback;
      status.textContent = '';
      result.hidden = false;
      result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    const resize = (file: File) => new Promise<{ data: string; mimeType: string }>((resolve, reject) => {
      const image = new Image();
      const objectUrl = URL.createObjectURL(file);
      image.onload = () => {
        URL.revokeObjectURL(objectUrl);
        const longest = Math.max(image.naturalWidth, image.naturalHeight);
        const scale = longest > 1200 ? 1200 / longest : 1;
        const canvas = document.createElement('canvas');
        canvas.width = Math.max(1, Math.round(image.naturalWidth * scale));
        canvas.height = Math.max(1, Math.round(image.naturalHeight * scale));
        const context = canvas.getContext('2d');
        if (!context) return reject(new Error('Could not prepare this image.'));
        context.fillStyle = '#ffffff'; context.fillRect(0, 0, canvas.width, canvas.height); context.drawImage(image, 0, 0, canvas.width, canvas.height);
        const encoded = canvas.toDataURL('image/jpeg', 0.76).split(',')[1];
        resolve({ data: encoded, mimeType: 'image/jpeg' });
      };
      image.onerror = () => { URL.revokeObjectURL(objectUrl); reject(new Error('Could not read this image.')); };
      image.src = objectUrl;
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const rightFile = right.files?.[0];
      if (!rightFile || !consent.checked || honeypot.value) { status.textContent = text().missing; return; }
      if (rightFile.size > limitBytes) { status.textContent = text().tooLarge; return; }
      const allowed = ['image/jpeg', 'image/png', 'image/webp'];
      if (!allowed.includes(rightFile.type)) { status.textContent = text().tooLarge; return; }
      const lastUse = Number(localStorage.getItem('click-jyotish-palm-last-use') || '0');
      if (Date.now() - lastUse < 10 * 60_000) { status.textContent = language === 'hi' ? 'कृपया दूसरी रीडिंग से पहले 10 मिनट प्रतीक्षा करें।' : 'Please wait 10 minutes before requesting another reading.'; return; }
      submit.disabled = true; status.textContent = text().preparing; result.hidden = true;
      try {
        const primary = await resize(rightFile);
        const fingerprint = Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(primary.data)))).map((byte) => byte.toString(16).padStart(2, '0')).join('');
        const cached = JSON.parse(localStorage.getItem('click-jyotish-palm-reading-cache') || 'null') as ({ fingerprint?: string } & PalmResponse) | null;
        if (cached?.fingerprint === fingerprint && cached.title && cached.reading) {
          showResult(cached); return;
        }
        status.textContent = text().thinking;
        const response = await fetch('/api/palm-reading', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ image: primary.data, mimeType: primary.mimeType, language, consent: true }) });
        const data = await response.json() as PalmResponse & { error?: string };
        if (!response.ok) throw new Error(data.error || text().unavailable);
        showResult(data);
        localStorage.setItem('click-jyotish-palm-last-use', String(Date.now()));
        localStorage.setItem('click-jyotish-palm-reading-cache', JSON.stringify({ fingerprint, title: data.title, reading: data.reading, sections: data.sections }));
      } catch (error) { status.textContent = error instanceof Error ? error.message : text().unavailable; }
      finally { submit.disabled = false; }
    });
    document.getElementById('palm-try-again')?.addEventListener('click', () => { result.hidden = true; form.scrollIntoView({ behavior: 'smooth', block: 'center' }); right.focus(); });
    setLanguage(language);
    document.addEventListener('click-jyotish-language-change', ((event: Event) => setLanguage((event as CustomEvent<{ language?: Language }>).detail?.language === 'hi' ? 'hi' : 'en')) as EventListener);
  }
  setupPalmReflection();
  document.addEventListener('astro:page-load', setupPalmReflection);
</script>

<style>
  .palm-tool{padding:72px 0 92px;background:radial-gradient(circle at 14% 12%,#26396f 0,transparent 24rem),radial-gradient(circle at 83% 75%,#472852 0,transparent 30rem),#070b1e}.palm-tool-grid{display:grid;grid-template-columns:minmax(0,.92fr) minmax(420px,1.08fr);gap:42px;align-items:start}.palm-tool-eyebrow,.palm-result-eyebrow{margin:0 0 12px;color:#f0c875;font-size:12px;font-weight:800;letter-spacing:1.7px}.palm-tool h1{margin:0 0 16px;color:#fffdf7;font-size:clamp(42px,5vw,66px)}.palm-tool-intro{max-width:620px;margin:0;color:#c7d4eb;font-size:19px;line-height:1.65}.palm-tool-privacy{display:flex;gap:11px;align-items:flex-start;max-width:590px;margin:26px 0;padding:16px 18px;border:1px solid #41648f;border-radius:12px;background:#101a3a}.palm-tool-privacy span{font-size:20px}.palm-tool-privacy p{margin:0;color:#dbe5fa;font-size:14px}.palm-tool-guidance h2,.palm-tool-human strong{color:#fffdf7;font-family:"DM Sans","Noto Serif Devanagari",sans-serif;font-size:18px}.palm-tool-guidance ul{display:grid;gap:10px;margin:13px 0 30px;padding:0;list-style:none}.palm-tool-guidance li{position:relative;padding-left:24px;color:#bac9e7}.palm-tool-guidance li::before{content:'✦';position:absolute;left:0;color:#f0c875}.palm-tool-human{max-width:590px;padding:20px;border-left:3px solid #e5b45f;background:#101936}.palm-tool-human p{margin:7px 0 13px;color:#c7d4eb}.palm-tool-human a{color:#f0c875;font-weight:800}.palm-tool-panel{padding:25px;border:1px solid #42648f;border-radius:18px;background:linear-gradient(145deg,#16264e,#101735);box-shadow:0 26px 55px #02061766}.palm-tool-panel form{display:grid;gap:12px}.palm-upload{position:relative;display:grid;grid-template-columns:auto 1fr;column-gap:12px;align-items:center;min-height:100px;padding:17px;border:1px dashed #6f91bf;border-radius:12px;background:#0b1430;cursor:pointer;transition:.2s}.palm-upload:hover,.palm-upload:focus-within{border-color:#f0c875;background:#111e42}.palm-upload-icon{grid-row:span 2;font-size:30px}.palm-upload-title{color:#fffdf7;font-weight:800}.palm-upload-title em{color:#f0c875;font-size:12px;font-style:normal}.palm-upload-detail{color:#aebfdf;font-size:13px}.palm-upload input{position:absolute;inset:0;opacity:0;cursor:pointer}.palm-upload-optional{min-height:79px;opacity:.9}.palm-file-name{min-height:17px;margin:-5px 3px 0;color:#b7d5ff;font-size:12px}.palm-consent{display:flex;gap:10px;align-items:flex-start;margin-top:8px;color:#c7d4eb;font-size:12px;line-height:1.5}.palm-consent input{width:18px;height:18px;margin:1px 0 0;accent-color:#d79c45}.palm-honeypot{position:absolute!important;left:-10000px!important;opacity:0!important}.palm-tool-panel button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;border:0;border-radius:9px;background:linear-gradient(135deg,#f0c875,#cb8b36);color:#07102a;font:800 15px "DM Sans","Noto Serif Devanagari",sans-serif;cursor:pointer}.palm-tool-panel button:hover{background:linear-gradient(135deg,#ffe0a3,#e3a14a)}.palm-tool-panel button:disabled{cursor:wait;filter:saturate(.6);opacity:.72}.palm-tool-disclaimer{margin:0;color:#aebbd6;font-size:11px;line-height:1.55}.palm-form-status{min-height:20px;margin:0;color:#ffe0a3;font-weight:700;font-size:13px}.palm-mobile-camera-guide{display:none}.palm-result{margin-top:20px;padding:22px;border:1px solid #d7a650;border-radius:13px;background:linear-gradient(145deg,#1d2549,#111933)}.palm-result h2{margin:0 0 17px;color:#fffdf7;font-size:28px}.palm-result-sections{display:grid;gap:10px}.palm-result-section{display:grid;grid-template-columns:29px 1fr;gap:10px;padding:13px;border:1px solid rgba(143,174,225,.3);border-radius:9px;background:rgba(4,12,37,.42)}.palm-result-section.palm-result-summary{border-color:rgba(240,200,117,.48);background:rgba(214,162,80,.09)}.palm-result-number{display:flex;align-items:flex-start;justify-content:center;padding-top:2px;color:#f0c875;font-size:11px;font-weight:900;letter-spacing:.04em}.palm-result-section h3{margin:0 0 4px;color:#f9fbff;font:800 13px "DM Sans","Noto Serif Devanagari",sans-serif}.palm-result-section p{margin:0;white-space:normal;color:#dbe5fa;font-size:13px;line-height:1.55}.palm-result-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.palm-result-actions a,.palm-result-actions button{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 15px;border-radius:7px;font-size:13px;font-weight:800}.palm-result-actions a{background:#d79c45;color:#07102a}.palm-result-actions button{border:1px solid #6682ae;background:transparent;color:#dbe5fa}@media(max-width:900px){.palm-tool{padding:50px 0 70px}.palm-tool-grid{grid-template-columns:1fr;gap:28px}.palm-tool-intro{font-size:17px}}@media(max-width:520px){.palm-tool{padding-top:40px}.palm-tool-panel{padding:16px}.palm-tool h1{font-size:42px}.palm-mobile-camera-guide{display:block;padding:15px;border:1px solid rgba(240,200,117,.48);border-radius:12px;background:linear-gradient(140deg,rgba(214,162,80,.16),rgba(70,133,215,.14))}.palm-camera-eyebrow{margin:0 0 10px;color:#f0c875;font-size:10px;font-weight:900;letter-spacing:1.4px}.palm-mobile-camera-guide ol{display:grid;gap:9px;margin:0 0 13px;padding:0;list-style:none}.palm-mobile-camera-guide li{display:grid;grid-template-columns:25px 1fr;gap:8px;align-items:start}.palm-mobile-camera-guide li>span{display:flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:#f0c875;color:#0b1331;font-size:11px;font-weight:900}.palm-mobile-camera-guide strong,.palm-mobile-camera-guide small{display:block}.palm-mobile-camera-guide strong{color:#fffdf7;font-size:12px}.palm-mobile-camera-guide small{margin-top:1px;color:#bed0ed;font-size:11px;line-height:1.35}.palm-tool-panel .palm-camera-trigger{width:100%;min-height:48px;background:linear-gradient(135deg,#79c9ff,#3884d5);color:#06122c}.palm-camera-note{margin:9px 0 0;color:#bdd0ed;font-size:10px;line-height:1.4}.palm-result-actions{flex-direction:column}.palm-result-actions a,.palm-result-actions button{width:100%}}
</style>
