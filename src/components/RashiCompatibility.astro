---
import { zodiacSigns } from '../data/zodiac';
---

<section class="rashi-compatibility" aria-labelledby="compatibility-title">
  <div class="wrap"><div class="compatibility-card">
    <div class="compatibility-copy">
      <p class="compatibility-eyebrow">COMPATIBILITY · अनुकूलता</p>
      <h2 id="compatibility-title">How do your Moon Rashis connect?</h2>
      <p>Choose both Janma Rashis for a quick, respectful compatibility overview. This is a starting point—not a complete Kundli Milan.</p>
    </div>
    <form id="rashi-compatibility-form" class="compatibility-form">
      <label for="your-rashi"><span>Your Chandra Rashi</span><select id="your-rashi" name="yourRashi">{zodiacSigns.map((sign) => <option value={sign.id}>{sign.icon} {sign.sanskrit} ({sign.nameHi})</option>)}</select></label>
      <span class="compatibility-heart" aria-hidden="true">♥</span>
      <label for="partner-rashi"><span>Partner's Chandra Rashi</span><select id="partner-rashi" name="partnerRashi">{zodiacSigns.map((sign, index) => <option value={sign.id} selected={index === 6}>{sign.icon} {sign.sanskrit} ({sign.nameHi})</option>)}</select></label>
      <button type="submit">Check overview</button>
    </form>
    <div id="compatibility-result" class="compatibility-result" hidden aria-live="polite">
      <strong id="compatibility-result-title"></strong><p id="compatibility-result-copy"></p>
      <small>For marriage matching, a full Kundli Milan reviews Nakshatra, Ashtakoota/Guna, Nadi, Bhakoot, Manglik and the wider birth charts.</small>
      <a href="/?service=marriage&utm_source=compatibility-checker&utm_medium=website&utm_campaign=kundli-milan#book">Request detailed Kundli Milan →</a>
    </div>
  </div></div>
</section>

<script>
  const compatibilityCopy = {
    en: {
      eyebrow: 'COMPATIBILITY · अनुकूलता', title: 'How do your Moon Rashis connect?',
      intro: 'Choose both Janma Rashis for a quick, respectful compatibility overview. This is a starting point—not a complete Kundli Milan.',
      yours: 'Your Chandra Rashi', partner: "Partner's Chandra Rashi", submit: 'Check overview',
      note: 'For marriage matching, a full Kundli Milan reviews Nakshatra, Ashtakoota/Guna, Nadi, Bhakoot, Manglik and the wider birth charts.',
      cta: 'Request detailed Kundli Milan →',
      sameTitle: 'A shared emotional rhythm', sameCopy: 'You may naturally understand each other’s priorities and reactions. Space for individuality keeps the relationship fresh.',
      supportiveTitle: 'A naturally supportive pairing', supportiveCopy: '{a} and {b} energy can complement each other well when communication stays honest and practical.',
      steadyTitle: 'A familiar, steady connection', steadyCopy: 'You may share an instinctive style, while a little patience helps prevent the same strengths from becoming blind spots.',
      growthTitle: 'A pairing that grows through understanding', growthCopy: '{a} and {b} energy can approach feelings and decisions differently. Respectful conversation helps turn those differences into balance.'
    },
    hi: {
      eyebrow: 'अनुकूलता · COMPATIBILITY', title: 'आपकी चंद्र राशियाँ कैसे जुड़ती हैं?',
      intro: 'त्वरित और सम्मानजनक अनुकूलता जानकारी के लिए दोनों जन्म राशियाँ चुनें। यह केवल शुरुआती संकेत है—पूर्ण कुंडली मिलान नहीं।',
      yours: 'आपकी चंद्र राशि', partner: 'साथी की चंद्र राशि', submit: 'अनुकूलता देखें',
      note: 'विवाह मिलान के लिए पूर्ण कुंडली मिलान में नक्षत्र, अष्टकूट/गुण, नाड़ी, भकूट, मांगलिक और विस्तृत जन्म कुंडली देखी जाती है।',
      cta: 'विस्तृत कुंडली मिलान का अनुरोध करें →',
      sameTitle: 'भावनात्मक तालमेल', sameCopy: 'आप एक-दूसरे की प्राथमिकताओं और प्रतिक्रियाओं को सहज रूप से समझ सकते हैं। व्यक्तिगत स्थान संबंध को ताज़ा रखता है।',
      supportiveTitle: 'स्वाभाविक रूप से सहायक जोड़ी', supportiveCopy: '{a} और {b} तत्व की ऊर्जा ईमानदार और व्यावहारिक संवाद के साथ एक-दूसरे की पूरक हो सकती है।',
      steadyTitle: 'परिचित और स्थिर जुड़ाव', steadyCopy: 'आपकी सहज शैली मिलती-जुलती हो सकती है; थोड़ा धैर्य समान शक्तियों को सीमाएँ बनने से रोकता है।',
      growthTitle: 'समझ से बढ़ने वाली जोड़ी', growthCopy: '{a} और {b} तत्व की ऊर्जा भावनाओं और निर्णयों को अलग तरह से देख सकती है। सम्मानजनक बातचीत इन अंतरों को संतुलन में बदलती है।'
    }
  } as const;
  const rashiDetails: Record<string, { name: string; element: string }> = {
    aries: { name: 'Mesha (Aries)', element: 'Fire' }, taurus: { name: 'Vrishabha (Taurus)', element: 'Earth' }, gemini: { name: 'Mithuna (Gemini)', element: 'Air' }, cancer: { name: 'Karka (Cancer)', element: 'Water' }, leo: { name: 'Simha (Leo)', element: 'Fire' }, virgo: { name: 'Kanya (Virgo)', element: 'Earth' }, libra: { name: 'Tula (Libra)', element: 'Air' }, scorpio: { name: 'Vrishchika (Scorpio)', element: 'Water' }, sagittarius: { name: 'Dhanu (Sagittarius)', element: 'Fire' }, capricorn: { name: 'Makara (Capricorn)', element: 'Earth' }, aquarius: { name: 'Kumbha (Aquarius)', element: 'Air' }, pisces: { name: 'Meena (Pisces)', element: 'Water' }
  };
  const hindiElements: Record<string, string> = { Fire: 'अग्नि', Earth: 'पृथ्वी', Air: 'वायु', Water: 'जल' };
  function describePair(first: string, second: string, language: 'en' | 'hi') {
    const a = rashiDetails[first]; const b = rashiDetails[second]; const pair = [a.element, b.element].sort().join('-');
    const text = compatibilityCopy[language]; const firstElement = language === 'hi' ? hindiElements[a.element] : a.element; const secondElement = language === 'hi' ? hindiElements[b.element] : b.element;
    if (first === second) return { title: text.sameTitle, copy: text.sameCopy };
    if (pair === 'Air-Fire' || pair === 'Earth-Water') return { title: text.supportiveTitle, copy: text.supportiveCopy.replace('{a}', firstElement).replace('{b}', secondElement) };
    if (pair === 'Air-Air' || pair === 'Earth-Earth' || pair === 'Fire-Fire' || pair === 'Water-Water') return { title: text.steadyTitle, copy: text.steadyCopy };
    return { title: text.growthTitle, copy: text.growthCopy.replace('{a}', firstElement).replace('{b}', secondElement) };
  }
  function setupCompatibilityChecker() {
    const form = document.getElementById('rashi-compatibility-form') as HTMLFormElement | null; const result = document.getElementById('compatibility-result') as HTMLElement | null; const resultTitle = document.getElementById('compatibility-result-title'); const resultCopy = document.getElementById('compatibility-result-copy');
    if (!form || !result || form.dataset.ready === 'true') return; form.dataset.ready = 'true';
    let language: 'en' | 'hi' = localStorage.getItem('click-jyotish-language') === 'hi' ? 'hi' : 'en';
    let lastPair: { yourRashi: string; partnerRashi: string } | null = null;
    const renderResult = () => { if (!lastPair) return; const overview = describePair(lastPair.yourRashi, lastPair.partnerRashi, language); if (resultTitle) resultTitle.textContent = `${rashiDetails[lastPair.yourRashi].name} & ${rashiDetails[lastPair.partnerRashi].name}: ${overview.title}`; if (resultCopy) resultCopy.textContent = overview.copy; };
    const applyCompatibilityLanguage = (nextLanguage: 'en' | 'hi') => {
      language = nextLanguage; const text = compatibilityCopy[language]; const section = document.querySelector('.rashi-compatibility');
      const set = (selector: string, value: string) => { const element = section?.querySelector<HTMLElement>(selector); if (element) element.textContent = value; };
      set('.compatibility-eyebrow', text.eyebrow); set('#compatibility-title', text.title); set('.compatibility-copy p', text.intro);
      const labels = section?.querySelectorAll<HTMLElement>('.compatibility-form label span'); if (labels?.[0]) labels[0].textContent = text.yours; if (labels?.[1]) labels[1].textContent = text.partner;
      set('.compatibility-form button', text.submit); set('.compatibility-result small', text.note); set('.compatibility-result a', text.cta); renderResult();
    };
    form.addEventListener('submit', (event) => { event.preventDefault(); const details = new FormData(form); lastPair = { yourRashi: String(details.get('yourRashi')), partnerRashi: String(details.get('partnerRashi')) }; renderResult(); result.hidden = false; });
    applyCompatibilityLanguage(language);
    document.addEventListener('click-jyotish-language-change', ((event: Event) => { const nextLanguage = (event as CustomEvent<{ language?: 'en' | 'hi' }>).detail?.language; applyCompatibilityLanguage(nextLanguage === 'hi' ? 'hi' : 'en'); }) as EventListener);
  }
  setupCompatibilityChecker(); document.addEventListener('astro:page-load', setupCompatibilityChecker);
</script>

<style>
  .rashi-compatibility{padding:0 0 30px;background:#f7f5ed}.compatibility-card{padding:32px 38px;border:1px solid #f0c5d3;border-radius:14px;background:linear-gradient(135deg,#fff5f8,#fdeaf0);box-shadow:0 12px 28px #5e19300b}.compatibility-copy{max-width:720px}.compatibility-eyebrow{margin:0 0 8px;color:#bf3e67;font-size:11px;font-weight:800;letter-spacing:1.5px}.compatibility-copy h2{margin:0 0 10px;color:#241b1e;font-size:clamp(26px,3vw,37px)}.compatibility-copy p{margin:0;color:#6c5960;line-height:1.6}.compatibility-form{display:grid;grid-template-columns:1fr auto 1fr auto;gap:14px;align-items:end;margin-top:24px}.compatibility-form label{display:grid;gap:7px}.compatibility-form label span{color:#806d73;font-size:11px;font-weight:800;letter-spacing:1px;text-transform:uppercase}.compatibility-form select{min-height:52px;padding:0 12px;border:1px solid #e3cdd4;border-radius:8px;background:#fffdfd;color:#291d21;font:inherit;font-weight:700}.compatibility-heart{align-self:center;margin-top:21px;color:#df5279;font-size:24px}.compatibility-form button{min-height:52px;padding:0 20px;border:0;border-radius:8px;background:#df5279;color:#fff;font:inherit;font-weight:800;cursor:pointer}.compatibility-form button:hover{background:#c94167}.compatibility-result{margin-top:22px;padding:18px 20px;border:1px solid #edbecd;border-radius:9px;background:#fffafd}.compatibility-result strong{color:#4b2935;font-size:17px}.compatibility-result p{margin:7px 0;color:#695661;line-height:1.55}.compatibility-result small{display:block;color:#856f79;line-height:1.45}.compatibility-result a{display:inline-block;margin-top:12px;color:#a42d51;font-size:14px;font-weight:800;text-decoration:none}@media(max-width:800px){.compatibility-card{padding:25px 21px}.compatibility-form{grid-template-columns:1fr}.compatibility-heart{margin:0;justify-self:center}.compatibility-form button{width:100%}}
</style>
