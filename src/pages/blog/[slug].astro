---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const formattedDate = post.data.pubDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
const wa = `https://wa.me/${site.phone}?text=${encodeURIComponent(`Namaste Deepak Ji, I read “${post.data.title}” and would like a consultation.`)}`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: site.astrologer },
  publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: 'https://clickjyotish.in/images/click-jyotish-logo.jpg' } },
  mainEntityOfPage: `https://clickjyotish.in/blog/${post.id}`
};
---
<BaseLayout title={`${post.data.title} | Click Jyotish`} description={post.data.description} structuredData={structuredData}>
  <header class="header"><div class="wrap inner"><a class="brand" href="/"><img src="/images/click-jyotish-logo.jpg" alt="Click Jyotish" />Click Jyotish</a><a class="back" href="/blog">← All articles</a></div></header>
  <main class="wrap article"><p class="meta">{post.data.category} · {formattedDate}</p><h1>{post.data.title}</h1><p class="lead">{post.data.description}</p><div class="tags">{post.data.tags.map((tag) => <span>{tag}</span>)}</div><article class="prose"><Content /></article>
    <aside><strong>Need personal guidance?</strong><p>Book a focused 15-minute online consultation with Deepak Maheshwari for {site.pricing.quickCall}, then confirm your preferred time on WhatsApp.</p><div><a class="gold" href={`/?utm_source=blog&utm_medium=article&utm_campaign=${post.id}#book`}>Book consultation</a><a class="wa" href={wa} target="_blank" rel="noreferrer">WhatsApp Deepak Ji</a></div></aside>
    <p class="disclaimer">This article provides general spiritual information. It is not medical, legal, financial or mental-health advice. Please read the <a href="/disclaimer">full disclaimer</a>.</p>
  </main>
</BaseLayout>
<style>
  .header{border-bottom:1px solid #dedbd1;background:#fcfaf5}.inner{height:76px;display:flex;justify-content:space-between;align-items:center}.brand{display:flex;align-items:center;gap:10px;font-family:"Playfair Display",serif;font-weight:700;font-size:20px}.brand img{width:43px;height:43px;border-radius:50%;object-fit:cover}.back{font-size:14px;color:#9b631a;font-weight:700}.article{width:min(780px,calc(100% - 40px));padding:72px 0 90px}.meta{font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:#a86f1e;font-weight:800}.article h1{font-size:clamp(39px,6vw,62px);margin:10px 0 19px}.lead{font-size:20px;color:#566276}.tags{display:flex;gap:8px;flex-wrap:wrap;margin:23px 0 35px}.tags span{font-size:12px;color:#705f48;background:#f3eadb;border-radius:99px;padding:5px 9px}.prose :global(h2){font-size:30px;margin:43px 0 12px}.prose :global(p),.prose :global(li){font-size:17px;color:#4e596d}.prose :global(li){margin:10px 0}.prose :global(ol),.prose :global(ul){padding-left:25px}aside{margin:50px 0 20px;background:#101936;color:#fff;padding:28px;border-radius:10px}aside strong{font-family:"Playfair Display",serif;font-size:25px;color:#e4b667}aside p{color:#d7ddea}.gold,.wa{display:inline-block;padding:11px 15px;border-radius:5px;font-weight:800;font-size:14px;margin:4px 8px 0 0}.gold{background:#c7913e;color:#101936}.wa{border:1px solid #71d69a;color:#fff}.disclaimer{font-size:13px;color:#687385}.disclaimer a{color:#9b631a;text-decoration:underline}@media(max-width:560px){.article{padding:45px 0 70px}.brand{font-size:18px}.back{font-size:12px}}
</style>
