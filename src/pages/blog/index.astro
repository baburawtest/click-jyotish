---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date: Date) => date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout title="Vedic Astrology, Vastu & Palmistry Articles | Click Jyotish" description="Read practical Click Jyotish articles about Vedic Astrology, festivals, Vastu, Palmistry, consultation preparation and spiritual living.">

  <main class="wrap page"><p class="eyebrow">READING & INSIGHTS</p><h1>Vedic reflections for everyday life</h1><p class="lead">Clear, respectful articles on Jyotish, Vastu, Palmistry, festivals and preparing for a personal consultation.</p>
    <div class="grid">{posts.map((post, index) => <article class="card">{post.data.featuredImage && <a class="card-image" href={`/blog/${post.id}`}><img src={post.data.featuredImage} alt={post.data.featuredImageAlt ?? ''} loading={index < 2 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} decoding="async" /></a>}<p class="meta">{post.data.category} · {formatDate(post.data.pubDate)}</p><h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2><p>{post.data.description}</p><a class="read" href={`/blog/${post.id}`}>Read article →</a></article>)}</div>
  </main>
</BaseLayout>
<style>
  .page{padding:75px 0 90px}.eyebrow,.meta{font-size:12px;letter-spacing:1.4px;text-transform:uppercase;color:#a86f1e;font-weight:800}.page h1{font-size:clamp(39px,6vw,63px);max-width:700px;margin:8px 0 16px}.lead{font-size:19px;color:#566276;max-width:710px;margin:0 0 44px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.card{overflow:hidden;background:#fff;border:1px solid #dedbd1;border-radius:10px;padding:28px;color:#45546b}.card-image{display:block;margin:-28px -28px 23px;overflow:hidden;border-radius:10px 10px 0 0;background:radial-gradient(circle at 25% 20%,#344a89,#0b122e 68%)}.card-image img{display:block;width:100%;height:220px;object-fit:cover}.card h2{margin:9px 0 12px;color:#14254b;font-size:26px}.card h2 a{color:#14254b}.card h2 a:hover{color:#98601b;text-decoration:underline}.read:hover{text-decoration:underline}.card p{color:#526075}.read{display:inline-block;margin-top:8px;color:#98601b;font-weight:800}@media(max-width:650px){.page{padding:46px 0 70px}.grid{grid-template-columns:1fr}.card h2{font-size:29px;line-height:1.16}}
</style>
