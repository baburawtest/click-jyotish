---
import InfoPageLayout from '../layouts/InfoPageLayout.astro';
import { faqs } from '../data/faq';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question', name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer }
  }))
};
---
<InfoPageLayout title="Frequently Asked Questions | Click Jyotish" description="Answers about Click Jyotish online Vedic Astrology, Vastu and Palmistry consultations, booking, privacy and the ₹600 15-minute call." eyebrow="CONSULTATION FAQ" {structuredData}>
  <p class="notice">For a personal question or the quickest booking help, message Deepak Ji on <a href="https://wa.me/917669655530" target="_blank" rel="noreferrer">WhatsApp</a>.</p>
  {faqs.map(({ question, answer }) => (
    <section class="faq-item"><h2>{question}</h2><p>{answer}</p></section>
  ))}
</InfoPageLayout>
