---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import DailyRashifal from '../components/DailyRashifal.astro';
import MoonRashiFinder from '../components/MoonRashiFinder.astro';
import RashiCompatibility from '../components/RashiCompatibility.astro';
import PanchangRequest from '../components/PanchangRequest.astro';
import ConsultationForm from '../components/ConsultationForm.astro';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: 'https://clickjyotish.in/',
  logo: 'https://clickjyotish.in/images/click-jyotish-logo.jpg',
  image: 'https://clickjyotish.in/images/deepak-maheshwari-yellow.png',
  description: 'Personal Vedic Astrology, Vastu and Palmistry consultations with Deepak Maheshwari.',
  telephone: `+${site.phone}`,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressCountry: 'IN'
  },
  areaServed: 'India',
  availableLanguage: ['Hindi', 'English']
};
---

<BaseLayout title={`${site.name} | Vedic Astrology, Vastu & Palmistry`} description="Book a personal online Vedic Astrology, Vastu or Palmistry consultation with Deepak Maheshwari. personal guidance in Hindi or English." structuredData={organizationSchema}>
  <main>
    <!-- Hero Section -->
    <section id="home" class="hero-section">
      <div class="dot-grid-pattern" aria-hidden="true"></div>

      <div class="wrap hero-container">
        <!-- Hero Left Content -->
        <div class="hero-content">
          <div class="hero-trust-pill">
            <span class="pulse-dot"></span>
            <span>ONLINE CONSULTATIONS · HINDI & ENGLISH</span>
          </div>

          <h1 class="hero-heading">
            Find clarity.<br />
            Move forward<br />
            with confidence.
          </h1>

          <p class="hero-lead">
            Personal guidance in Vedic Astrology, Vastu Shastra and Palmistry with {site.astrologer}—offered with sincere care, confidentiality and practical perspective.
          </p>

          <div class="hero-cta-group">
            <a class="btn btn-gold btn-hero" href="#book">
              Choose consultation
            </a>
            <a class="btn btn-whatsapp" href={site.whatsappUrl} target="_blank" rel="noreferrer">
              Chat on WhatsApp
            </a>
            <a class="btn btn-outline" href="#services">
              Explore services ↓
            </a>
          </div>

          <div class="hero-badges-row">
            <div class="h-badge-item">
              <span class="hb-icon">🛡️</span>
              <span>100% Confidential</span>
            </div>
            <div class="h-badge-item">
              <span class="hb-icon">📞</span>
              <span>1-on-1 Direct Call</span>
            </div>
            <div class="h-badge-item">
              <span class="hb-icon">⚡</span>
              <span>Practical Remedies</span>
            </div>
          </div>
        </div>

        <!-- Hero Right Cosmic Graphic -->
        <div class="hero-visual" aria-hidden="true">
          <div class="cosmic-orbit-system">
            <div class="orbit-ring ring-outer"></div>
            <div class="orbit-ring ring-mid"></div>
            <div class="orbit-ring ring-inner"></div>

            <div class="central-sun" title="Chandra · Moon">
              <span class="om-symbol">☾</span>
            </div>

            <div class="planet planet-gold"></div>
            <div class="planet planet-blue"></div>
            <div class="planet planet-white"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Moon-sign explanation and free finder -->
    <MoonRashiFinder />

    <!-- Quick Moon-Rashi compatibility overview -->
    <RashiCompatibility />

    <!-- Daily Rashifal & Horoscope Component -->
    <DailyRashifal />

    <!-- Free Daily Panchang Component -->
    <PanchangRequest />

    <!-- Services Section -->
    <section id="services" class="section services-section">
      <div class="wrap">
        <div class="section-header text-center">
          <p class="eyebrow-text">OUR CONSULTATION DOMAINS</p>
          <h2>Personalized Guidance & Remedies</h2>
          <p class="section-desc">Grounded in classical Parashari & Jaimini Vedic texts, delivered with modern clarity.</p>
        </div>

        <div class="services-grid">
          {site.services.map((srv) => (
            <div class="service-card">
              <div class="service-icon">{srv.icon}</div>
              <h3>{srv.title}</h3>
              <p>{srv.desc}</p>
              <a href={srv.link} class="service-link">
                Explore this service →
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section consultation-expectations">
      <div class="wrap expectations-grid">
        <div class="expectations-intro">
          <p class="eyebrow-text">A CLEAR CONSULTATION EXPERIENCE</p>
          <h2>Personal guidance, without unnecessary complexity.</h2>
          <p>Choose the service that fits your question. We collect only the details that are relevant, confirm the suitable time, and keep the conversation focused on practical clarity.</p>
          <a href="#book" class="text-cta">Start your consultation request →</a>
        </div>
        <div class="expectations-list">
          <article><span>01</span><div><h3>Choose your focus</h3><p>Kundali, career, relationships, Palmistry or Vastu.</p></div></article>
          <article><span>02</span><div><h3>Share only relevant details</h3><p>Birth details for Kundali work; property information for Vastu; your question for Palmistry.</p></div></article>
          <article><span>03</span><div><h3>Confirm your session personally</h3><p>Choose a calendar slot or confirm the best time directly on WhatsApp.</p></div></article>
        </div>
      </div>
    </section>

    <!-- Meet The Astrologer Section -->
    <section id="about" class="section about-section">
      <div class="wrap about-grid">
        <div class="about-image-wrapper">
          <img src="/images/deepak-maheshwari.png" alt="Deepak Maheshwari - Click Jyotish" class="about-img" />
          <div class="about-badge">
            <span>Deepak Maheshwari</span>
            <small>Vedic Astrologer & Vastu Practitioner</small>
          </div>
        </div>

        <div class="about-content">
          <p class="eyebrow-text">MEET THE PRACTITIONER</p>
          <h2>Clear, Compassionate & Actionable Advice</h2>
          <p>
            Astrology is not about fatalism or creating fear. It is a time-tested Vedic science of self-awareness and planetary timing, helping you understand your inherent potentials, challenge cycles (Dasha), and upcoming auspicious windows.
          </p>
          <p>
            With disciplined practice in Janam Kundli analysis, Vastu principles, and Palmistry, Deepak Maheshwari provides confidential, direct, and practical consultations focused on empowering your life decisions.
          </p>
          <div class="about-stats">
            <div class="stat-item">
              <span class="stat-num">100%</span>
              <span class="stat-lbl">Confidential & Direct</span>
            </div>
            <div class="stat-item">
              <span class="stat-num">15 Min</span>
              <span class="stat-lbl">Focused online calls</span>
            </div>
            <div class="stat-item">
              <span class="stat-num">Direct</span>
              <span class="stat-lbl">WhatsApp Booking</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Consultation & Lead Booking Form Component -->
    <ConsultationForm />

    <!-- Insights / Articles Section -->
    <section id="insights" class="section insights-section">
      <div class="wrap">
        <div class="section-header text-center">
          <p class="eyebrow-text">READING & INSIGHTS</p>
          <h2>Articles & Vedic Reflections</h2>
        </div>

        <div class="insights-grid">
          {site.insights.map((article) => (
            <div class="insight-card">
              <span class="insight-date">{article.date}</span>
              <h3>{article.title}</h3>
              <p>{article.summary}</p>
              <a href={article.link} class="insight-link">Read full article →</a>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <!-- Sticky Floating Mobile Booking Bar -->
  <div class="floating-mobile-bar" aria-label="Quick booking">
    <a href="#book" class="f-btn f-book-btn">
      <span>Start consultation</span>
    </a>
    <a href={site.whatsappUrl} target="_blank" rel="noreferrer" class="f-btn f-wa-btn" aria-label="Chat on WhatsApp">
      <span>WhatsApp 💬</span>
    </a>
  </div>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="wrap footer-content">
      <div class="footer-brand">
        <span class="footer-title">{site.name}</span>
        <p>Vedic Astrology, Vastu & Palmistry by Deepak Maheshwari</p>
        <p class="footer-loc">📍 {site.city}, India · Email: {site.email}</p>
      </div>
      <div class="footer-links">
        <a href="#home">Home</a>
        <a href="#rashifal">Daily Rashifal</a>
        <a href="#panchang">Panchang & Muhurat</a>
        <a href="#services">Services</a>
        <a href="#about">About</a>
        <a href="#book">Book Consultation</a>
        <a href="/blog">Articles & Insights</a>
        <a href="/faq">FAQ</a>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms-and-conditions">Terms</a>
        <a href="/disclaimer">Disclaimer</a>
        <a href="/refund-and-rescheduling">Booking Policy</a>
      </div>
    </div>
    <div class="wrap footer-bottom">
      <p>© {new Date().getFullYear()} Click Jyotish. All rights reserved. Astrology is a spiritual guidance practice and is not a substitute for medical, legal, or financial professional advice.</p>
    </div>
  </footer>
</BaseLayout>

<style>
  /* Header Nav */
  .navbarwrap {
    background: #fcfaf5;
    border-bottom: 1px solid #dedbd1;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .top {
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .consultation-strip {
    background: #f5ead4;
    border-bottom: 1px solid #e2c793;
    color: #493116;
    font-size: 13px;
  }
  .consultation-strip-inner {
    min-height: 42px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .consultation-strip strong { color: #6d4211; }
  .consultation-strip a { color: #8a5514; font-weight: 800; white-space: nowrap; }
  .consultation-strip a:hover { text-decoration: underline; }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }
  .logo-img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 1.5px solid #c7913e;
  }
  .brand-titles {
    display: flex;
    flex-direction: column;
  }
  .brand-name {
    font-family: "Playfair Display", serif;
    font-size: 22px;
    font-weight: 700;
    color: #18213d;
    line-height: 1.1;
  }
  .brand-sub {
    font-size: 10px;
    letter-spacing: 1.5px;
    color: #c7913e;
    font-weight: 700;
    text-transform: uppercase;
  }
  .nav-links {
    display: flex;
    gap: 24px;
    align-items: center;
  }
  .nav-links a {
    font-size: 14.5px;
    font-weight: 500;
    color: #18213d;
    transition: color 0.2s ease;
  }
  .nav-links a:hover {
    color: #c7913e;
  }
  .nav-book-link {
    color: #c7913e !important;
    font-weight: 700 !important;
  }
  .btn-header-cta {
    padding: 10px 18px;
    font-size: 13.5px;
  }

  /* Hero Section */
  .hero-section {
    background: #101936;
    color: #ffffff;
    position: relative;
    padding: 90px 0 110px;
    overflow: hidden;
  }
  .dot-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.12) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
    opacity: 0.7;
  }
  .hero-container {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 40px;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  .hero-trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(199, 145, 62, 0.15);
    border: 1px solid rgba(199, 145, 62, 0.4);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 11px;
    letter-spacing: 1.5px;
    font-weight: 700;
    color: #e5b364;
    margin-bottom: 20px;
  }
  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
  }
  .hero-heading {
    font-size: clamp(40px, 5.2vw, 64px);
    line-height: 1.1;
    font-weight: 600;
    margin: 0 0 22px;
    color: #ffffff;
  }
  .hero-lead {
    font-size: 17.5px;
    line-height: 1.6;
    color: #cbd5e1;
    max-width: 540px;
    margin-bottom: 32px;
  }
  .hero-cta-group {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 26px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    transition: all 0.25s ease;
    cursor: pointer;
    border: none;
  }
  .btn-gold {
    background: #c7913e;
    color: #101936;
  }
  .btn-gold:hover {
    background: #dba44e;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(199, 145, 62, 0.35);
  }
  .btn-whatsapp {
    background: #25d366;
    color: #ffffff;
  }
  .btn-whatsapp:hover {
    background: #1ebe5d;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.3);
  }
  .btn-outline {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
  }
  .btn-outline:hover {
    border-color: #c7913e;
    color: #c7913e;
  }
  .hero-badges-row {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .h-badge-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #cbd5e1;
  }

  /* Cosmic Orbit Visual */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .cosmic-orbit-system {
    position: relative;
    width: 340px;
    height: 340px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .orbit-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  .ring-outer { width: 320px; height: 320px; }
  .ring-mid { width: 240px; height: 240px; border-color: rgba(199, 145, 62, 0.25); }
  .ring-inner { width: 160px; height: 160px; }
  .central-sun {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fffdf1 0%, #e8d9aa 48%, #c7913e 100%);
    box-shadow: 0 0 35px rgba(232, 217, 170, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
  }
  .om-symbol {
    font-family: "Noto Serif Devanagari", serif;
    font-size: 38px;
    color: #18213d;
    font-weight: 700;
  }
  .planet { position: absolute; border-radius: 50%; }
  .planet-gold { width: 14px; height: 14px; background: #eab308; top: 55px; left: 70px; box-shadow: 0 0 10px #eab308; }
  .planet-blue { width: 12px; height: 12px; background: #38bdf8; bottom: 75px; right: 55px; box-shadow: 0 0 10px #38bdf8; }
  .planet-white { width: 8px; height: 8px; background: #ffffff; top: 130px; right: 15px; }

  /* Sections */
  .section { padding: 85px 0; }
  .text-center { text-align: center; max-width: 680px; margin: 0 auto 40px; }
  .eyebrow-text {
    font-size: 11px;
    letter-spacing: 2px;
    color: #c7913e;
    font-weight: 700;
    margin-bottom: 12px;
    text-transform: uppercase;
  }
  .section-header h2 { font-size: 36px; color: #18213d; margin: 0 0 12px; }
  .section-desc { font-size: 16px; color: #64748b; margin: 0; }

  /* Services Grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 28px;
  }
  .service-card {
    background: #ffffff;
    border: 1px solid #dedbd1;
    border-radius: 10px;
    padding: 32px 26px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.06);
    border-color: #c7913e;
  }
  .service-icon { font-size: 34px; margin-bottom: 16px; }
  .service-card h3 { font-size: 21px; color: #18213d; margin: 0 0 12px; }
  .service-card p { font-size: 14.5px; color: #475569; line-height: 1.6; margin-bottom: 20px; }
  .service-link { font-size: 14px; font-weight: 700; color: #c7913e; text-decoration: none; }

  /* Consultation expectations */
  .consultation-expectations { background: #101936; color: #ffffff; }
  .expectations-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }
  .expectations-intro h2 { margin: 0 0 18px; font-size: clamp(32px, 4vw, 47px); line-height: 1.12; }
  .expectations-intro > p:not(.eyebrow-text) { margin: 0 0 22px; color: #cbd5e1; font-size: 17px; line-height: 1.65; }
  .text-cta { color: #f1c16b; font-weight: 800; text-decoration: none; }
  .expectations-list { border-top: 1px solid #ffffff26; }
  .expectations-list article { display: grid; grid-template-columns: 52px 1fr; gap: 16px; padding: 20px 0; border-bottom: 1px solid #ffffff26; }
  .expectations-list article > span { color: #e5b45f; font-weight: 800; font-size: 13px; letter-spacing: 1px; }
  .expectations-list h3 { margin: 0 0 6px; font-size: 18px; }
  .expectations-list p { margin: 0; color: #cbd5e1; line-height: 1.55; font-size: 14px; }

  /* About Section */
  .about-section { background: #edf0f6; }
  .about-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 60px; align-items: center; }
  .about-image-wrapper { position: relative; }
  .about-img {
    width: 100%;
    height: 440px;
    object-fit: cover;
    object-position: center top;
    border-radius: 10px;
    border: 1px solid #dedbd1;
  }
  .about-badge {
    position: absolute;
    bottom: -20px;
    right: 20px;
    background: #101936;
    color: #ffffff;
    padding: 16px 24px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
  }
  .about-badge span { font-family: "Playfair Display", serif; font-size: 18px; font-weight: 600; color: #c7913e; }
  .about-badge small { font-size: 12px; color: #cbd5e1; }
  .about-content h2 { font-size: 34px; color: #18213d; margin: 0 0 20px; }
  .about-content p { font-size: 15.5px; color: #475569; line-height: 1.7; margin-bottom: 16px; }
  .about-stats { display: flex; gap: 32px; margin-top: 32px; flex-wrap: wrap; }
  .stat-num {
    display: block;
    font-family: "Playfair Display", serif;
    font-size: 26px;
    font-weight: 700;
    color: #c7913e;
  }
  .stat-lbl { font-size: 13px; color: #64748b; }

  /* Insights */
  .insights-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 28px; }
  .insight-card { background: #ffffff; border: 1px solid #dedbd1; border-radius: 8px; padding: 30px; }
  .insight-date { font-size: 11px; letter-spacing: 1.5px; color: #c7913e; font-weight: 700; }
  .insight-card h3 { font-size: 21px; color: #18213d; margin: 10px 0 12px; }
  .insight-card p { font-size: 14.5px; color: #475569; margin-bottom: 20px; }
  .insight-link { font-size: 14px; font-weight: 700; color: #c7913e; }

  /* Floating Mobile Booking Bar */
  .floating-mobile-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #101936;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding: 10px 16px;
    display: none;
    gap: 12px;
    z-index: 99;
    box-shadow: 0 -4px 20px rgba(0,0,0,0.25);
  }
  .f-btn {
    flex: 1;
    text-align: center;
    padding: 12px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }
  .f-book-btn { background: #c7913e; color: #101936; }
  .f-wa-btn { background: #25d366; color: #ffffff; }

  /* Footer */
  .site-footer {
    background: #0b1126;
    color: #94a3b8;
    padding: 60px 0 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 36px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    flex-wrap: wrap;
    gap: 32px;
  }
  .footer-title {
    font-family: "Playfair Display", serif;
    font-size: 22px;
    color: #ffffff;
    font-weight: 700;
    display: block;
    margin-bottom: 6px;
  }
  .footer-loc { font-size: 13px; color: #cbd5e1; margin-top: 8px; }
  .footer-links { display: flex; gap: 20px; flex-wrap: wrap; }
  .footer-links a { color: #cbd5e1; font-size: 14px; }
  .footer-links a:hover { color: #c7913e; }
  .footer-bottom { padding-top: 24px; font-size: 12px; text-align: center; color: #64748b; }

  /* Responsive */
  @media (max-width: 900px) {
    .hero-container { grid-template-columns: 1fr; text-align: center; }
    .hero-lead { margin: 0 auto 32px; }
    .hero-cta-group, .hero-badges-row { justify-content: center; }
    .about-grid { grid-template-columns: 1fr; }
    .expectations-grid { grid-template-columns: 1fr; gap: 35px; }
    .nav-links { display: none; }
    .floating-mobile-bar { display: flex; }
    body { padding-bottom: 65px; }
    .consultation-strip-inner { min-height: 48px; font-size: 12px; }
  }
