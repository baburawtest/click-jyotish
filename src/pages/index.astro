      choose: 'Choose consultation', chat: 'Chat on WhatsApp', explore: 'Explore services ↓',
      badges: ['100% Confidential', '1-on-1 Direct Call', 'Practical Remedies'],
      servicesEyebrow: 'OUR CONSULTATION DOMAINS', servicesTitle: 'Personalized Guidance & Remedies', servicesLead: 'Grounded in classical Parashari & Jaimini Vedic texts, delivered with modern clarity.',
      services: [
        ['Vedic Astrology & Kundali Reading', 'In-depth analysis of your Janam Kundli, planetary dasha, career, health, finances and relationship timing.'],
