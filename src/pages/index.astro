---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import DailyRashifal from '../components/DailyRashifal.astro';
import MoonRashiFinder from '../components/MoonRashiFinder.astro';
import RashiCompatibility from '../components/RashiCompatibility.astro';
import PanchangRequest from '../components/PanchangRequest.astro';
import ConsultationForm from '../components/ConsultationForm.astro';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://clickjyotish.in/#business',
  name: site.name,
  url: 'https://clickjyotish.in/',
  sameAs: ['https://maps.app.goo.gl/s5ALfH8iLjqHVTVQ7'],
  logo: 'https://clickjyotish.in/images/click-jyotish-logo.jpg',
  image: 'https://clickjyotish.in/images/deepak-maheshwari-yellow.png',
  description: 'Personal Vedic Astrology, Vastu and Palmistry consultations with Deepak Maheshwari.',
  telephone: `+${site.phone}`,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: 'Delhi',
    addressCountry: 'IN'
  },
  areaServed: [
    { '@type': 'City', name: 'New Delhi' },
    { '@type': 'AdministrativeArea', name: 'Delhi NCR' },
    { '@type': 'Country', name: 'India' }
  ],
  availableLanguage: ['Hindi', 'English'],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: `+${site.phone}`,
    email: site.email,
    contactType: 'customer service',
    areaServed: 'IN',
    availableLanguage: ['Hindi', 'English']
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Click Jyotish consultation services',
    itemListElement: [
      {
        '@type': 'Offer',
        price: '600',
        priceCurrency: 'INR',
        itemOffered: {
          '@type': 'Service',
          name: 'Vedic Astrology and Kundali Consultation',
          description: 'Personal online guidance for Janam Kundli, Dasha, career, relationships and timing.'
        }
      },
      {
        '@type': 'Offer',
        price: '600',
        priceCurrency: 'INR',
        itemOffered: {
          '@type': 'Service',
          name: 'Palmistry and Hastarekha Consultation',
          description: 'Personal online Palmistry guidance focused on strengths, patterns and life-direction questions.'
        }
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Vastu Shastra Consultation',
          description: 'Practical Vastu guidance for homes, offices and commercial spaces; scope is confirmed individually.'
        }
      }
    ]
  },
  potentialAction: {
    '@type': 'ReserveAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: site.bookingLink,
      actionPlatform: ['https://schema.org/DesktopWebPlatform', 'https://schema.org/MobileWebPlatform']
    },
    name: 'Book a consultation'
  }
};
---

<BaseLayout title={`${site.name} | Vedic Astrology, Vastu & Palmistry`} description="Book a personal online Vedic Astrology, Vastu or Palmistry consultation with Deepak Maheshwari. personal guidance in Hindi or English." structuredData={organizationSchema}>
  <main>
    <!-- Hero Section -->
    <section id="home" class="hero-section">
      <div class="dot-grid-pattern" aria-hidden="true"></div>

      <div class="wrap hero-container">
        <!-- Hero Left Content -->
        <div class="hero-content">
          <div class="hero-trust-pill">
            <span class="pulse-dot"></span>
            <span>ONLINE CONSULTATIONS · HINDI & ENGLISH</span>
          </div>

          <h1 class="hero-heading">
            Find clarity.<br />
            Move forward<br />
            with confidence.
          </h1>

          <p class="hero-lead">
            Personal guidance in Vedic Astrology, Vastu Shastra and Palmistry with {site.astrologer}—offered with sincere care, confidentiality and practical perspective.
          </p>

          <div class="hero-cta-group">
            <a class="btn btn-gold btn-hero" href="#book">
              Choose consultation
            </a>
            <a class="btn btn-whatsapp" href={site.whatsappUrl} target="_blank" rel="noreferrer">
              Chat on WhatsApp
            </a>
            <a class="btn btn-outline" href="#services">
              Explore services ↓
            </a>
          </div>

          <div class="hero-badges-row">
            <div class="h-badge-item">
              <span class="hb-icon">🛡️</span>
              <span>100% Confidential</span>
            </div>
            <div class="h-badge-item">
              <span class="hb-icon">📞</span>
              <span>1-on-1 Direct Call</span>
            </div>
            <div class="h-badge-item">
              <span class="hb-icon">⚡</span>
              <span>Practical Remedies</span>
            </div>
          </div>
        </div>

        <!-- Hero Right Cosmic Graphic -->
        <div class="hero-visual" aria-hidden="true">
          <div class="cosmic-orbit-system">
            <div class="orbit-ring ring-outer"></div>
            <div class="orbit-ring ring-mid"></div>
            <div class="orbit-ring ring-inner"></div>

            <div class="central-sun" title="Chandra · Moon">
              <span class="om-symbol">☾</span>
            </div>

            <div class="planet planet-gold"></div>
            <div class="planet planet-blue"></div>
            <div class="planet planet-white"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Moon-sign explanation and free finder -->
    <MoonRashiFinder />

    <!-- Quick Moon-Rashi compatibility overview -->
    <RashiCompatibility />

    <!-- Daily Rashifal & Horoscope Component -->
    <DailyRashifal />

    <!-- Free Daily Panchang Component -->
    <PanchangRequest />

    <!-- Services Section -->
    <section id="services" class="section services-section">
      <div class="wrap">
        <div class="section-header text-center">
          <p class="eyebrow-text">OUR CONSULTATION DOMAINS</p>
          <h2>Personalized Guidance & Remedies</h2>
          <p class="section-desc">Grounded in classical Parashari & Jaimini Vedic texts, delivered with modern clarity.</p>
        </div>

        <div class="services-grid">
          {site.services.map((srv) => (
            <div class="service-card">
              <div class="service-icon">{srv.icon}</div>
              <h3>{srv.title}</h3>
              <p>{srv.desc}</p>
              <a href={srv.link} class="service-link">
                Explore this service →
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section consultation-expectations">
      <div class="wrap expectations-grid">
        <div class="expectations-intro">
          <p class="eyebrow-text">A CLEAR CONSULTATION EXPERIENCE</p>
          <h2>Personal guidance, without unnecessary complexity.</h2>
          <p>Choose the service that fits your question. We collect only the details that are relevant, confirm the suitable time, and keep the conversation focused on practical clarity.</p>
          <a href="#book" class="text-cta">Start your consultation request →</a>
        </div>
        <div class="expectations-list">
          <article><span>01</span><div><h3>Choose your focus</h3><p>Kundali, career, relationships, Palmistry or Vastu.</p></div></article>
          <article><span>02</span><div><h3>Share only relevant details</h3><p>Birth details for Kundali work; property information for Vastu; your question for Palmistry.</p></div></article>
          <article><span>03</span><div><h3>Confirm your session personally</h3><p>Choose a calendar slot or confirm the best time directly on WhatsApp.</p></div></article>
        </div>
      </div>
    </section>

    <!-- Meet The Astrologer Section -->
    <section id="about" class="section about-section">
      <div class="wrap about-grid">
        <div class="about-image-wrapper">
          <img src="/images/deepak-maheshwari.png" alt="Deepak Maheshwari - Click Jyotish" class="about-img" />
          <div class="about-badge">
            <span>Deepak Maheshwari</span>
            <small>Vedic Astrologer & Vastu Practitioner</small>
          </div>
        </div>

        <div class="about-content">
          <p class="eyebrow-text">MEET THE PRACTITIONER</p>
          <h2>Clear, Compassionate & Actionable Advice</h2>
          <p>
            Astrology is not about fatalism or creating fear. It is a time-tested Vedic science of self-awareness and planetary timing, helping you understand your inherent potentials, challenge cycles (Dasha), and upcoming auspicious windows.
          </p>
          <p>
            With disciplined practice in Janam Kundli analysis, Vastu principles, and Palmistry, Deepak Maheshwari provides confidential, direct, and practical consultations focused on empowering your life decisions.
          </p>
          <div class="about-stats">
            <div class="stat-item">
              <span class="stat-num">100%</span>
              <span class="stat-lbl">Confidential & Direct</span>
            </div>
            <div class="stat-item">
              <span class="stat-num">15 Min</span>
              <span class="stat-lbl">Focused online calls</span>
            </div>
            <div class="stat-item">
              <span class="stat-num">Direct</span>
              <span class="stat-lbl">WhatsApp Booking</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Consultation & Lead Booking Form Component -->
    <ConsultationForm />

    <!-- Insights / Articles Section -->
    <section id="insights" class="section insights-section">
      <div class="wrap">
        <div class="section-header text-center">
          <p class="eyebrow-text">READING & INSIGHTS</p>
          <h2>Articles & Vedic Reflections</h2>
        </div>

        <div class="insights-grid">
          {site.insights.map((article) => (
            <div class="insight-card">
              <span class="insight-date">{article.date}</span>
              <h3>{article.title}</h3>
              <p>{article.summary}</p>
              <a href={article.link} class="insight-link">Read full article →</a>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <!-- Sticky Floating Mobile Booking Bar -->
  <div class="floating-mobile-bar" aria-label="Quick booking">
    <a href="#book" class="f-btn f-book-btn">
      <span>Start consultation</span>
    </a>
    <a href={site.whatsappUrl} target="_blank" rel="noreferrer" class="f-btn f-wa-btn" aria-label="Chat on WhatsApp">
      <span>WhatsApp 💬</span>
    </a>
  </div>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="wrap footer-content">
      <div class="footer-brand">
        <span class="footer-title">{site.name}</span>
        <p>Vedic Astrology, Vastu & Palmistry by Deepak Maheshwari</p>
        <p class="footer-loc">📍 {site.city}, India · Email: {site.email}</p>
      </div>
      <div class="footer-links">
        <a href="#home">Home</a>
        <a href="#rashifal">Daily Rashifal</a>
        <a href="#panchang">Panchang & Muhurat</a>
        <a href="#services">Services</a>
        <a href="#about">About</a>
        <a href="#book">Book Consultation</a>
        <a href="/blog">Articles & Insights</a>
        <a href="/faq">FAQ</a>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms-and-conditions">Terms</a>
        <a href="/disclaimer">Disclaimer</a>
        <a href="/refund-and-rescheduling">Booking Policy</a>
      </div>
    </div>
    <div class="wrap footer-bottom">
      <p>© {new Date().getFullYear()} Click Jyotish. All rights reserved. Astrology is a spiritual guidance practice and is not a substitute for medical, legal, or financial professional advice.</p>
    </div>
  </footer>
</BaseLayout>

<script>
  type HomeLanguage = 'en' | 'hi';

  const homeCopy = {
    en: {
      trust: 'ONLINE CONSULTATIONS · HINDI & ENGLISH',
      hero: 'Find clarity.<br>Move forward<br>with confidence.',
      lead: 'Personal guidance in Vedic Astrology, Vastu Shastra and Palmistry with Deepak Maheshwari—offered with sincere care, confidentiality and practical perspective.',
      choose: 'Choose consultation', chat: 'Chat on WhatsApp', explore: 'Explore services ↓',
      badges: ['100% Confidential', '1-on-1 Direct Call', 'Practical Remedies'],
      servicesEyebrow: 'OUR CONSULTATION DOMAINS', servicesTitle: 'Personalized Guidance & Remedies', servicesLead: 'Grounded in classical Parashari & Jaimini Vedic texts, delivered with modern clarity.',
      services: [
        ['Vedic Astrology & Kundali Reading', 'In-depth analysis of your Janam Kundli, planetary dasha, career, health, finances and relationship timing.'],
        ['Vastu Shastra Consultation', 'Harmonise your home, office, or commercial space with practical, non-destructive Vastu remedies.'],
        ['Palmistry (Hastarekha)', 'Understand your innate character, life line, fate line, potential health indications and natural strengths.']
      ],
      serviceLink: 'Explore this service →',
      experienceEyebrow: 'A CLEAR CONSULTATION EXPERIENCE', experienceTitle: 'Personal guidance, without unnecessary complexity.',
      experienceLead: 'Choose the service that fits your question. We collect only the details that are relevant, confirm the suitable time, and keep the conversation focused on practical clarity.',
      experienceCta: 'Start your consultation request →',
      steps: [
        ['Choose your focus', 'Kundali, career, relationships, Palmistry or Vastu.'],
        ['Share only relevant details', 'Birth details for Kundali work; property information for Vastu; your question for Palmistry.'],
        ['Confirm your session personally', 'Choose a calendar slot or confirm the best time directly on WhatsApp.']
      ],
      aboutEyebrow: 'MEET THE PRACTITIONER', aboutTitle: 'Clear, Compassionate & Actionable Advice',
      about: [
        'Astrology is not about fatalism or creating fear. It is a time-tested Vedic science of self-awareness and planetary timing, helping you understand your inherent potentials, challenge cycles (Dasha), and upcoming auspicious windows.',
        'With disciplined practice in Janam Kundli analysis, Vastu principles, and Palmistry, Deepak Maheshwari provides confidential, direct, and practical consultations focused on empowering your life decisions.'
      ],
      practitioner: 'Vedic Astrologer & Vastu Practitioner', stats: ['Confidential & Direct', 'Focused online calls', 'WhatsApp Booking'],
      insightsEyebrow: 'READING & INSIGHTS', insightsTitle: 'Articles & Vedic Reflections',
      insights: [
        ['DIWALI 2026 · VASTU', 'Diwali Vastu Checklist: Prepare Your Home With Intention', 'A practical and respectful checklist for preparing your home or workplace before Deepavali.'],
        ['PALMISTRY · PREPARATION', 'Online Palmistry: How to Prepare Your Hand Photos', 'A respectful, practical guide to preparing for an online Palmistry consultation.'],
        ['VASTU · PRACTICAL GUIDE', 'Before a Vastu Consultation: A Simple Home Checklist', 'What to prepare before discussing a home, office or workplace with a Vastu practitioner.']
      ],
      read: 'Read full article →', mobile: 'Start consultation', footer: 'Vedic Astrology, Vastu & Palmistry by Deepak Maheshwari',
      footerLinks: ['Home', 'Daily Rashifal', 'Panchang & Muhurat', 'Services', 'About', 'Book Consultation', 'Articles & Insights', 'FAQ', 'Privacy Policy', 'Terms', 'Disclaimer', 'Booking Policy'],
      legal: 'All rights reserved. Astrology is a spiritual guidance practice and is not a substitute for medical, legal, or financial professional advice.'
    },
    hi: {
      trust: 'ऑनलाइन परामर्श · हिंदी और अंग्रेज़ी',
      hero: 'स्पष्टता पाएँ।<br>आत्मविश्वास के साथ<br>आगे बढ़ें।',
      lead: 'दीपक महेश्वरी के साथ वैदिक ज्योतिष, वास्तु शास्त्र और हस्तरेखा पर व्यक्तिगत मार्गदर्शन—सच्ची देखभाल, गोपनीयता और व्यावहारिक दृष्टिकोण के साथ।',
      choose: 'परामर्श चुनें', chat: 'WhatsApp पर बात करें', explore: 'सेवाएँ देखें ↓',
      badges: ['100% गोपनीय', 'सीधी व्यक्तिगत कॉल', 'व्यावहारिक उपाय'],
      servicesEyebrow: 'परामर्श के प्रमुख क्षेत्र', servicesTitle: 'व्यक्तिगत मार्गदर्शन एवं उपाय', servicesLead: 'पराशरी और जैमिनी के शास्त्रीय वैदिक ग्रंथों पर आधारित, आधुनिक स्पष्टता के साथ।',
      services: [
        ['वैदिक ज्योतिष एवं कुंडली विश्लेषण', 'जन्म कुंडली, ग्रह दशा, करियर, स्वास्थ्य, धन और संबंधों के समय का गहन विश्लेषण।'],
        ['वास्तु शास्त्र परामर्श', 'व्यावहारिक और बिना तोड़फोड़ वाले वास्तु उपायों से घर, कार्यालय या व्यावसायिक स्थान में सामंजस्य।'],
        ['हस्तरेखा विश्लेषण', 'अपने स्वभाव, जीवन रेखा, भाग्य रेखा, स्वास्थ्य के संकेतों और सहज शक्तियों को समझें।']
      ],
      serviceLink: 'इस सेवा को जानें →',
      experienceEyebrow: 'सरल परामर्श अनुभव', experienceTitle: 'बिना अनावश्यक जटिलता के व्यक्तिगत मार्गदर्शन।',
      experienceLead: 'अपने प्रश्न के अनुसार सेवा चुनें। हम केवल आवश्यक जानकारी लेते हैं, सही समय की पुष्टि करते हैं और बातचीत को व्यावहारिक स्पष्टता पर केंद्रित रखते हैं।',
      experienceCta: 'परामर्श अनुरोध शुरू करें →',
      steps: [
        ['अपना विषय चुनें', 'कुंडली, करियर, संबंध, हस्तरेखा या वास्तु।'],
        ['केवल आवश्यक जानकारी दें', 'कुंडली के लिए जन्म विवरण; वास्तु के लिए संपत्ति जानकारी; हस्तरेखा के लिए अपना प्रश्न।'],
        ['व्यक्तिगत रूप से सत्र पक्का करें', 'कैलेंडर स्लॉट चुनें या WhatsApp पर सीधे सही समय पक्का करें।']
      ],
      aboutEyebrow: 'विशेषज्ञ से मिलें', aboutTitle: 'स्पष्ट, संवेदनशील और व्यावहारिक सलाह',
      about: [
        'ज्योतिष भाग्यवाद या भय पैदा करने के बारे में नहीं है। यह आत्म-समझ और ग्रहों के समय का एक अनुभवी वैदिक विज्ञान है, जो आपकी क्षमताओं, चुनौतीपूर्ण दशाओं और आने वाले शुभ अवसरों को समझने में मदद करता है।',
        'जन्म कुंडली विश्लेषण, वास्तु सिद्धांतों और हस्तरेखा के अनुशासित अभ्यास के साथ दीपक महेश्वरी आपके जीवन के निर्णयों को सशक्त बनाने के लिए गोपनीय, सीधे और व्यावहारिक परामर्श देते हैं।'
      ],
      practitioner: 'वैदिक ज्योतिषी एवं वास्तु सलाहकार', stats: ['गोपनीय और व्यक्तिगत', 'केंद्रित ऑनलाइन कॉल', 'WhatsApp बुकिंग'],
      insightsEyebrow: 'लेख एवं विचार', insightsTitle: 'लेख और वैदिक चिंतन',
      insights: [
        ['दिवाली 2026 · वास्तु', 'दिवाली वास्तु चेकलिस्ट: अपने घर को सही भाव से तैयार करें', 'दीपावली से पहले घर या कार्यस्थल की तैयारी के लिए एक व्यावहारिक और सम्मानजनक सूची।'],
        ['हस्तरेखा · तैयारी', 'ऑनलाइन हस्तरेखा: हाथों की तस्वीरें कैसे तैयार करें', 'ऑनलाइन हस्तरेखा परामर्श की तैयारी के लिए एक व्यावहारिक मार्गदर्शिका।'],
        ['वास्तु · व्यावहारिक मार्गदर्शिका', 'वास्तु परामर्श से पहले: घर के लिए एक सरल चेकलिस्ट', 'वास्तु विशेषज्ञ से घर, कार्यालय या कार्यस्थल पर बात करने से पहले क्या तैयार करें।']
      ],
      read: 'पूरा लेख पढ़ें →', mobile: 'परामर्श शुरू करें', footer: 'दीपक महेश्वरी द्वारा वैदिक ज्योतिष, वास्तु एवं हस्तरेखा',
      footerLinks: ['होम', 'दैनिक राशिफल', 'पंचांग एवं मुहूर्त', 'सेवाएँ', 'परिचय', 'परामर्श बुक करें', 'लेख एवं विचार', 'प्रश्नोत्तर', 'गोपनीयता नीति', 'नियम एवं शर्तें', 'अस्वीकरण', 'बुकिंग नीति'],
      legal: 'सर्वाधिकार सुरक्षित। ज्योतिष आध्यात्मिक मार्गदर्शन की विधि है और यह चिकित्सा, कानूनी या वित्तीय विशेषज्ञ सलाह का विकल्प नहीं है।'
    }
  } as const;

  const setHomeText = (selector: string, value: string) => {
    const element = document.querySelector<HTMLElement>(selector);
    if (element) element.textContent = value;
  };
  const setHomeHtml = (selector: string, value: string) => {
    const element = document.querySelector<HTMLElement>(selector);
    if (element) element.innerHTML = value;
  };
  const applyHomeLanguage = (language: HomeLanguage) => {
    const text = homeCopy[language];
    setHomeText('.hero-trust-pill span:last-child', text.trust);
    setHomeHtml('.hero-heading', text.hero);
    setHomeText('.hero-lead', text.lead);
    const heroActions = document.querySelectorAll<HTMLElement>('.hero-cta-group a');
    [text.choose, text.chat, text.explore].forEach((value, index) => { if (heroActions[index]) heroActions[index].textContent = value; });
    const badges = document.querySelectorAll<HTMLElement>('.hero-badges-row .h-badge-item span:last-child');
    text.badges.forEach((value, index) => { if (badges[index]) badges[index].textContent = value; });

    setHomeText('#services .eyebrow-text', text.servicesEyebrow);
    setHomeText('#services h2', text.servicesTitle);
    setHomeText('#services .section-desc', text.servicesLead);
    const serviceCards = document.querySelectorAll<HTMLElement>('.service-card');
    text.services.forEach((service, index) => {
      const card = serviceCards[index];
      if (!card) return;
      const title = card.querySelector<HTMLElement>('h3'); const description = card.querySelector<HTMLElement>('p'); const link = card.querySelector<HTMLElement>('a');
      if (title) title.textContent = service[0]; if (description) description.textContent = service[1]; if (link) link.textContent = text.serviceLink;
    });

    setHomeText('.expectations-intro .eyebrow-text', text.experienceEyebrow);
    setHomeText('.expectations-intro h2', text.experienceTitle);
    setHomeText('.expectations-intro > p:not(.eyebrow-text)', text.experienceLead);
    setHomeText('.expectations-intro .text-cta', text.experienceCta);
    const steps = document.querySelectorAll<HTMLElement>('.expectations-list article');
    text.steps.forEach((step, index) => {
      const item = steps[index]; const heading = item?.querySelector<HTMLElement>('h3'); const copy = item?.querySelector<HTMLElement>('p');
      if (heading) heading.textContent = step[0]; if (copy) copy.textContent = step[1];
    });

    setHomeText('.about-badge small', text.practitioner);
    setHomeText('#about .eyebrow-text', text.aboutEyebrow);
    setHomeText('.about-content h2', text.aboutTitle);
    const aboutParagraphs = document.querySelectorAll<HTMLElement>('.about-content > p:not(.eyebrow-text)');
    text.about.forEach((paragraph, index) => { if (aboutParagraphs[index]) aboutParagraphs[index].textContent = paragraph; });
    const statLabels = document.querySelectorAll<HTMLElement>('.stat-lbl');
    text.stats.forEach((value, index) => { if (statLabels[index]) statLabels[index].textContent = value; });

    setHomeText('#insights .eyebrow-text', text.insightsEyebrow);
    setHomeText('#insights h2', text.insightsTitle);
    const insights = document.querySelectorAll<HTMLElement>('.insight-card');
    text.insights.forEach((article, index) => {
      const card = insights[index];
      if (!card) return;
      const date = card.querySelector<HTMLElement>('.insight-date'); const title = card.querySelector<HTMLElement>('h3'); const summary = card.querySelector<HTMLElement>('p'); const link = card.querySelector<HTMLElement>('a');
      if (date) date.textContent = article[0]; if (title) title.textContent = article[1]; if (summary) summary.textContent = article[2]; if (link) link.textContent = text.read;
    });
    setHomeText('.f-book-btn span', text.mobile);
    setHomeText('.footer-brand > p:first-of-type', text.footer);
    const footerLinks = document.querySelectorAll<HTMLElement>('.footer-links a');
    text.footerLinks.forEach((value, index) => { if (footerLinks[index]) footerLinks[index].textContent = value; });
    const legal = document.querySelector<HTMLElement>('.footer-bottom p');
    if (legal) legal.textContent = `© ${new Date().getFullYear()} Click Jyotish. ${text.legal}`;
  };

  const currentHomeLanguage: HomeLanguage = localStorage.getItem('click-jyotish-language') === 'hi' ? 'hi' : 'en';
  applyHomeLanguage(currentHomeLanguage);
  document.addEventListener('click-jyotish-language-change', ((event: Event) => {
    const language = (event as CustomEvent<{ language?: HomeLanguage }>).detail?.language;
    applyHomeLanguage(language === 'hi' ? 'hi' : 'en');
  }) as EventListener);
</script>

