---
import BaseLayout from '../layouts/BaseLayout.astro';
import { content, site } from '../data/site';
const wa = `https://wa.me/${site.phone}?text=${encodeURIComponent('Namaste Deepak Ji, I would like to book a 15-minute consultation (Rs. 600).')}`;
---
<BaseLayout title={`${site.name} | Vedic Astrology, Vastu & Palmistry`}>
  <header class="top wrap">
    <a class="brand" href="#home"><img src="/images/click-jyotish-logo.jpg" alt="Click Jyotish logo" /><span>{site.name}<small>Vedic guidance</small></span></a>
    <nav>{content.en.nav.map((item, i) => <a href={['#home','#services','#about','#insights','#contact'][i]} data-nav={i}>{item}</a>)}</nav>
    <button id="language" aria-label="Switch language">हिंदी</button>
  </header>
  <main>
    <section id="home" class="hero">
      <div class="stars"></div>
      <div class="floating-symbols" aria-hidden="true">
        <span class="sym s1">☉</span><span class="sym s2">☽</span><span class="sym s3">☿</span><span class="sym s4">♀</span><span class="sym s5">♂</span><span class="sym s6">♃</span><span class="sym s7">♄</span>
      </div>
      <div class="wrap hero-grid"><div class="hero-copy">
        <p class="eyebrow" data-text="eyebrow">{content.en.eyebrow}</p><h1 data-text="title">{content.en.title}</h1><p class="intro" data-text="intro">{content.en.intro}</p>
        <div class="actions"><a class="button gold" href={site.bookingLink} target="_blank" rel="noreferrer" data-text="primary">{content.en.primary}</a><a class="button ghost" href="#services" data-text="secondary">{content.en.secondary}</a></div>
        <p class="proof" data-text="proof">{content.en.proof}</p>
      </div><div class="cosmic-card" aria-hidden="true"><div class="orbit orbit-a"></div><div class="orbit orbit-b"></div><div class="sun">ॐ</div><span class="planet p1"></span><span class="planet p2"></span><span class="planet p3"></span></div></div>
    </section>
    <section id="services" class="section wrap"><p class="eyebrow gold-text">Offerings</p><h2 data-text="servicesTitle">{content.en.servicesTitle}</h2><div class="cards">{content.en.services.map((service, i) => <article class="service"><span>0{i+1}</span><h3 data-service-title={i}>{service[0]}</h3><p data-service-copy={i}>{service[1]}</p><a href="#contact">Learn more <b>→</b></a></article>)}</div></section>
    <section class="process"><div class="wrap"><p class="eyebrow pale">How it works</p><h2 data-text="processTitle">{content.en.processTitle}</h2><div class="steps">{content.en.process.map((step,i) => <div><span>0{i+1}</span><h3 data-process-title={i}>{step[0]}</h3><p data-process-copy={i}>{step[1]}</p></div>)}</div></div></section>
    <section id="about" class="section wrap about"><div class="portrait"><img src="/images/vedic-astrology-about.jpg" alt="Vedic Astrology manuscripts and traditional tools" /></div><div><p class="eyebrow gold-text">About {site.practitioner}</p><h2 data-text="aboutTitle">{content.en.aboutTitle}</h2><p data-text="about">{content.en.about}</p><blockquote data-text="quote">{content.en.quote}</blockquote></div></section>
    <section id="insights" class="section wrap"><p class="eyebrow gold-text">Insights</p><h2 data-text="insightsTitle">{content.en.insightsTitle}</h2><div class="posts"><article><a href="/blog/guru-purnima-2026/"><div class="post-image image-0">☾</div><p>JYOTISH NOTES · JULY 2026</p><h3>Guru Purnima 2026: Meaning, Date & a Simple Practice</h3><span>A timely guide for 29 July, written for New Delhi readers.</span></a></article>{content.en.insights.slice(1).map((post,i) => <article><div class={`post-image image-${i+1}`}>✦</div><p>COMING SOON</p><h3 data-insight-title={i+1}>{post[0]}</h3><span data-insight-copy={i+1}>{post[1]}</span></article>)}</div></section>
    <section id="contact" class="contact"><div class="wrap contact-inner"><div><p class="eyebrow pale">15-minute online consultation · ₹600</p><h2 data-text="contactTitle">{content.en.contactTitle}</h2><p data-text="contact">{content.en.contact}</p></div><div class="contact-actions"><a class="button gold" href={site.bookingLink} target="_blank" rel="noreferrer" data-text="primary">{content.en.primary}</a><a class="email" href={wa} target="_blank" rel="noreferrer" data-text="whatsapp">{content.en.whatsapp}</a><a class="email" href={`mailto:${site.email}`}>{site.email}</a></div></div></section>
  </main>
  <footer class="wrap"><span>© {new Date().getFullYear()} {site.name}</span><span data-text="footer">{content.en.footer}</span><small data-text="note">{content.en.note}</small></footer>
</BaseLayout>
<script define:vars={{ content }}>
  let lang = 'en'; const langButton = document.querySelector('#language');
  const setText = (selector, values) => document.querySelectorAll(selector).forEach((el, i) => el.textContent = Array.isArray(values) ? values[i] : values);
  langButton?.addEventListener('click', () => { lang = lang === 'en' ? 'hi' : 'en'; const t = content[lang]; document.documentElement.lang = lang; langButton.textContent = lang === 'en' ? 'हिंदी' : 'English';
    document.querySelectorAll('[data-text]').forEach(el => { const key = el.dataset.text; if (key && t[key]) el.textContent = t[key]; });
    setText('[data-nav]', t.nav); setText('[data-service-title]', t.services.map(x=>x[0])); setText('[data-service-copy]', t.services.map(x=>x[1])); setText('[data-process-title]', t.process.map(x=>x[0])); setText('[data-process-copy]', t.process.map(x=>x[1])); setText('[data-insight-title]', t.insights.map(x=>x[0])); setText('[data-insight-copy]', t.insights.map(x=>x[1]));
  });

  // Intersection Observer for smooth scroll reveal animations
  const observerOptions = { threshold: 0.1, rootMargin: '0px 0px -40px 0px' };
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('active');
      }
    });
  }, observerOptions);

  document.querySelectorAll('.section, .service, .steps > div, .about, .posts article, .contact-inner').forEach((el, idx) => {
    el.classList.add('reveal');
    el.style.transitionDelay = `${(idx % 3) * 0.15}s`;
    observer.observe(el);
  });
</script>
<style>
  .top{height:78px;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;gap:10px;align-items:center;font-family:"Playfair Display",serif;font-size:19px;font-weight:700}.brand small{display:block;font-family:"DM Sans",sans-serif;font-size:9px;letter-spacing:1.6px;text-transform:uppercase;font-weight:500}.mark{color:var(--gold);font-size:29px}nav{display:flex;gap:27px;font-size:14px}nav a{transition:color 0.3s ease}nav a:hover{color:var(--gold)}button{border:1px solid var(--line);background:transparent;border-radius:20px;padding:7px 11px;color:var(--ink);cursor:pointer;font:inherit;font-size:13px;transition:all 0.3s ease}button:hover{border-color:var(--gold);color:var(--gold);transform:scale(1.04)}.hero{background:var(--night);color:white;position:relative;overflow:hidden}.hero-grid{min-height:620px;display:grid;grid-template-columns:1.08fr .92fr;align-items:center;position:relative}.hero-copy{z-index:1}.eyebrow{font-size:11px;letter-spacing:2px;text-transform:uppercase;font-weight:700;margin:0 0 17px;color:#78829b}.hero .eyebrow,.pale{color:#cdd4e9}.hero h1{font-size:clamp(48px,6vw,76px);max-width:700px;margin:0 0 23px}.intro{max-width:570px;font-size:18px;color:#d8dbe5;margin:0 0 31px}.actions{display:flex;gap:12px;flex-wrap:wrap}
  .button{padding:13px 21px;border-radius:4px;font-size:14px;font-weight:700;display:inline-block;transition:all 0.3s ease}.gold{background:var(--gold);color:#14192c;box-shadow:0 4px 15px rgba(199,145,62,0.3)}.gold:hover{transform:translateY(-3px);box-shadow:0 8px 25px rgba(199,145,62,0.6)}.ghost{border:1px solid #8c94a9;color:white}.ghost:hover{background:rgba(255,255,255,0.1);border-color:white;transform:translateY(-3px)}.proof{color:#b5bdce;font-size:13px;margin-top:30px}
  .stars{background-image:radial-gradient(#fff 1px,transparent 1px),radial-gradient(#c7913e 1px,transparent 1px);background-size:53px 53px,97px 97px;background-position:4px 5px,18px 23px;opacity:.23;position:absolute;inset:0;animation:twinkle 6s infinite ease-in-out}
  .floating-symbols{position:absolute;inset:0;pointer-events:none;z-index:0}.sym{position:absolute;color:var(--gold);font-size:22px;opacity:0.35;animation:floatGlyph 7s infinite ease-in-out}.s1{top:15%;left:8%;animation-delay:0s}.s2{top:70%;left:5%;animation-delay:1.5s}.s3{top:25%;right:48%;animation-delay:3s}.s4{top:82%;right:42%;animation-delay:2s}.s5{top:10%;right:12%;animation-delay:4s}.s6{bottom:15%;right:8%;animation-delay:2.5s}.s7{top:45%;left:40%;animation-delay:5s}
  .cosmic-card{width:min(390px,75vw);height:390px;border:1px solid #4b5575;border-radius:50%;margin:auto;position:relative;background:radial-gradient(circle,#28365f 0 18%,transparent 19%);box-shadow:0 0 40px rgba(40,54,95,0.5)}.orbit{position:absolute;border:1px solid #6c7590;border-radius:50%;inset:48px;animation:orbitRotate 35s linear infinite}.orbit-b{inset:100px;transform:rotate(60deg);animation:orbitRotateRev 25s linear infinite}.sun{position:absolute;inset:calc(50% - 45px);width:90px;height:90px;border-radius:50%;background:var(--gold);display:grid;place-items:center;font-size:42px;color:var(--night);box-shadow:0 0 50px #c7913e;animation:sunPulse 4s infinite ease-in-out}.planet{position:absolute;border-radius:50%;background:#e4c486;width:14px;height:14px}.p1{top:74px;left:92px}.p2{bottom:60px;right:77px;background:#8ebed2}.p3{top:187px;right:16px;width:9px;height:9px}.section{padding:104px 0}.section h2,.process h2,.contact h2{font-size:clamp(36px,4.5vw,53px);margin:0 0 42px;max-width:680px}.gold-text{color:#a86f1e}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}
  .service{border:1px solid var(--line);padding:28px;min-height:275px;display:flex;flex-direction:column;border-radius:6px;transition:all 0.35s cubic-bezier(0.16,1,0.3,1);background:white}.service:hover{transform:translateY(-8px);box-shadow:0 16px 35px rgba(199,145,62,0.14);border-color:var(--gold)}.service>span,.steps>div>span{color:var(--gold);font-size:12px;font-weight:700}.service h3{font-size:25px;margin:32px 0 10px;transition:color 0.3s ease}.service:hover h3{color:#9f681a}.service p{color:#626a7b;font-size:14px;margin:0}.service a{margin-top:auto;padding-top:20px;color:#9f681a;font-size:13px;font-weight:700}.service b{margin-left:4px;display:inline-block;transition:transform 0.3s ease}.service:hover a b{transform:translateX(6px)}
  .process{background:var(--night);color:white;padding:90px 0;position:relative;overflow:hidden}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:52px}.steps h3{font-size:24px;margin:23px 0 8px}.steps p{color:#bdc4d7;margin:0;font-size:14px}.steps>div{transition:transform 0.3s ease}.steps>div:hover{transform:translateY(-4px)}
  .about{display:grid;grid-template-columns:.85fr 1.15fr;gap:8vw;align-items:center}.about h2{margin-bottom:24px}.about>div>p:not(.eyebrow){color:#535c70;font-size:17px}.portrait{height:430px;background:linear-gradient(145deg,#d9b46e,#34415f);display:grid;place-items:center;overflow:hidden;border-radius:8px;box-shadow:0 10px 30px rgba(0,0,0,0.15);transition:transform 0.4s ease, box-shadow 0.4s ease}.portrait:hover{transform:scale(1.02);box-shadow:0 15px 40px rgba(199,145,62,0.3)}.portrait img{width:100%;height:100%;object-fit:cover;object-position:center;transition:transform 0.6s ease}.portrait:hover img{transform:scale(1.05)}.about blockquote{border-left:3px solid var(--gold);margin:30px 0 0;padding:4px 0 4px 19px;font-family:"Playfair Display",serif;font-size:21px}
  .posts{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.posts article{transition:transform 0.35s ease, box-shadow 0.35s ease;border-radius:6px;overflow:hidden}.posts article:hover{transform:translateY(-6px);box-shadow:0 12px 28px rgba(0,0,0,0.08)}.post-image{height:190px;background:#e8ded0;display:grid;place-items:center;color:#b78232;font-size:50px;transition:transform 0.4s ease}.posts article:hover .post-image{transform:scale(1.04)}.image-1{background:#dfe4ed;color:#526484}.image-2{background:#e6ddd3;color:#986e39}.posts p{font-size:10px;letter-spacing:1.7px;color:#a86f1e;font-weight:700;margin:17px 0 6px}.posts h3{font-size:25px;margin:0 0 7px}.posts span{color:#60697a;font-size:14px}
  .contact{background:#21315a;color:white;padding:80px 0}.contact-inner{display:flex;justify-content:space-between;align-items:center;gap:40px}.contact h2{margin-bottom:13px}.contact p:not(.eyebrow){color:#d1d9e9;max-width:550px}.contact-actions{display:flex;flex-direction:column;align-items:flex-start;gap:14px}.email{border-bottom:1px solid #97a3c0;font-size:14px;transition:color 0.3s ease, border-color 0.3s ease}.email:hover{color:var(--gold);border-color:var(--gold)}footer{padding:28px 0;display:grid;grid-template-columns:1fr 1fr 2fr;gap:20px;font-size:13px;color:#60697a}footer small{font-size:10px;line-height:1.45}
  
  /* Scroll Reveal Utilities */
  .reveal{opacity:0;transform:translateY(28px);transition:opacity 0.75s cubic-bezier(0.16,1,0.3,1), transform 0.75s cubic-bezier(0.16,1,0.3,1)}.reveal.active{opacity:1;transform:translateY(0)}
  
  /* Keyframes */
  @keyframes orbitRotate{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
  @keyframes orbitRotateRev{from{transform:rotate(60deg)}to{transform:rotate(-300deg)}}
  @keyframes sunPulse{0%,100%{box-shadow:0 0 35px #c7913e, 0 0 70px rgba(199,145,62,0.35);transform:scale(1)}50%{box-shadow:0 0 65px #ffd27d, 0 0 90px rgba(255,210,125,0.65);transform:scale(1.05)}}
  @keyframes twinkle{0%,100%{opacity:.23;transform:scale(1)}50%{opacity:.45;transform:scale(1.05)}}
  @keyframes floatGlyph{0%,100%{transform:translateY(0px) rotate(0deg);opacity:0.35}50%{transform:translateY(-16px) rotate(10deg);opacity:0.65}}

  @media(max-width:760px){.top{height:66px}nav{display:none}.hero-grid{grid-template-columns:1fr;min-height:720px;padding:70px 0}.cosmic-card{width:285px;height:285px}.hero h1{font-size:48px}.cards,.steps,.posts{grid-template-columns:1fr}.about{grid-template-columns:1fr}.portrait{height:260px}.contact-inner{display:block}.contact-actions{margin-top:25px}footer{grid-template-columns:1fr}.section{padding:72px 0}.process{padding:70px 0}}
  .brand img{width:46px;height:46px;border-radius:50%;object-fit:cover}.portrait{overflow:hidden;background:#d9b46e;border-radius:8px}.portrait img{width:100%;height:100%;object-fit:cover;object-position:center}
</style>

