    }
  } as const;

  const setHomeText = (selector: string, value: string) => {
    const element = document.querySelector<HTMLElement>(selector);
    if (element) element.textContent = value;
  };
  const setHomeHtml = (selector: string, value: string) => {
    const element = document.querySelector<HTMLElement>(selector);
    if (element) element.innerHTML = value;
  };
  const applyHomeLanguage = (language: HomeLanguage) => {
    const text = homeCopy[language];
    setHomeText('.hero-trust-pill span:last-child', text.trust);
    setHomeHtml('.hero-heading', text.hero);
    setHomeText('.hero-lead', text.lead);
    const heroActions = document.querySelectorAll<HTMLElement>('.hero-cta-group a');
    [text.choose, text.chat, text.explore].forEach((value, index) => { if (heroActions[index]) heroActions[index].textContent = value; });
    const badges = document.querySelectorAll<HTMLElement>('.hero-badges-row .h-badge-item span:last-child');
    text.badges.forEach((value, index) => { if (badges[index]) badges[index].textContent = value; });

    setHomeText('#services .eyebrow-text', text.servicesEyebrow);
    setHomeText('#services h2', text.servicesTitle);
    setHomeText('#services .section-desc', text.servicesLead);
    const serviceCards = document.querySelectorAll<HTMLElement>('.service-card');
    text.services.forEach((service, index) => {
      const card = serviceCards[index];
      if (!card) return;
      const title = card.querySelector<HTMLElement>('h3'); const description = card.querySelector<HTMLElement>('p'); const link = card.querySelector<HTMLElement>('a');
      if (title) title.textContent = service[0]; if (description) description.textContent = service[1]; if (link) link.textContent = text.serviceLink;
    });

    setHomeText('.expectations-intro .eyebrow-text', text.experienceEyebrow);
    setHomeText('.expectations-intro h2', text.experienceTitle);
    setHomeText('.expectations-intro > p:not(.eyebrow-text)', text.experienceLead);
    setHomeText('.expectations-intro .text-cta', text.experienceCta);
    const steps = document.querySelectorAll<HTMLElement>('.expectations-list article');
    text.steps.forEach((step, index) => {
      const item = steps[index]; const heading = item?.querySelector<HTMLElement>('h3'); const copy = item?.querySelector<HTMLElement>('p');
      if (heading) heading.textContent = step[0]; if (copy) copy.textContent = step[1];
    });

    setHomeText('.about-badge small', text.practitioner);
    setHomeText('#about .eyebrow-text', text.aboutEyebrow);
    setHomeText('.about-content h2', text.aboutTitle);
    const aboutParagraphs = document.querySelectorAll<HTMLElement>('.about-content > p:not(.eyebrow-text)');
    text.about.forEach((paragraph, index) => { if (aboutParagraphs[index]) aboutParagraphs[index].textContent = paragraph; });
    const statLabels = document.querySelectorAll<HTMLElement>('.stat-lbl');
    text.stats.forEach((value, index) => { if (statLabels[index]) statLabels[index].textContent = value; });

    setHomeText('#insights .eyebrow-text', text.insightsEyebrow);
    setHomeText('#insights h2', text.insightsTitle);
    const insights = document.querySelectorAll<HTMLElement>('.insight-card');
    text.insights.forEach((article, index) => {
      const card = insights[index];
      if (!card) return;
      const date = card.querySelector<HTMLElement>('.insight-date'); const title = card.querySelector<HTMLElement>('h3'); const summary = card.querySelector<HTMLElement>('p'); const link = card.querySelector<HTMLElement>('a');
      if (date) date.textContent = article[0]; if (title) title.textContent = article[1]; if (summary) summary.textContent = article[2]; if (link) link.textContent = text.read;
    });
    setHomeText('.f-book-btn span', text.mobile);
    setHomeText('.footer-brand > p:first-of-type', text.footer);
    const footerLinks = document.querySelectorAll<HTMLElement>('.footer-links a');
    text.footerLinks.forEach((value, index) => { if (footerLinks[index]) footerLinks[index].textContent = value; });
    const legal = document.querySelector<HTMLElement>('.footer-bottom p');
    if (legal) legal.textContent = `© ${new Date().getFullYear()} Click Jyotish. ${text.legal}`;
  };

  const currentHomeLanguage: HomeLanguage = document.body.dataset.pageLocale === 'hi' || localStorage.getItem('click-jyotish-language') === 'hi' ? 'hi' : 'en';
  applyHomeLanguage(currentHomeLanguage);
  document.addEventListener('click-jyotish-language-change', ((event: Event) => {
    const language = (event as CustomEvent<{ language?: HomeLanguage }>).detail?.language;
    applyHomeLanguage(language === 'hi' ? 'hi' : 'en');
  }) as EventListener);

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('motion-ready');
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -24px' });

    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((element) => revealObserver.observe(element));
  }
</script>

