      experienceCta: 'परामर्श अनुरोध शुरू करें →',
      steps: [
        ['अपना विषय चुनें', 'कुंडली, करियर, संबंध, हस्तरेखा या वास्तु।'],
        ['केवल आवश्यक जानकारी दें', 'कुंडली के लिए जन्म विवरण; वास्तु के लिए संपत्ति जानकारी; हस्तरेखा के लिए अपना प्रश्न।'],
        ['व्यक्तिगत रूप से सत्र पक्का करें', 'कैलेंडर स्लॉट चुनें या WhatsApp पर सीधे सही समय पक्का करें।']
      ],
      aboutEyebrow: 'विशेषज्ञ से मिलें', aboutTitle: 'स्पष्ट, संवेदनशील और व्यावहारिक सलाह',
      about: [
        'ज्योतिष भाग्यवाद या भय पैदा करने के बारे में नहीं है। यह आत्म-समझ और ग्रहों के समय का एक अनुभवी वैदिक विज्ञान है, जो आपकी क्षमताओं, चुनौतीपूर्ण दशाओं और आने वाले शुभ अवसरों को समझने में मदद करता है।',
        'जन्म कुंडली विश्लेषण, वास्तु सिद्धांतों और हस्तरेखा के अनुशासित अभ्यास के साथ दीपक महेश्वरी आपके जीवन के निर्णयों को सशक्त बनाने के लिए गोपनीय, सीधे और व्यावहारिक परामर्श देते हैं।'
      ],
      practitioner: 'वैदिक ज्योतिषी एवं वास्तु सलाहकार', stats: ['गोपनीय और व्यक्तिगत', 'केंद्रित ऑनलाइन कॉल', 'WhatsApp बुकिंग'],
      insightsEyebrow: 'लेख एवं विचार', insightsTitle: 'लेख और वैदिक चिंतन',
