---
import { site } from '../data/site';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  locale?: 'en' | 'hi';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = `${site.name} | ${site.tagline}`,
  description = 'Personal Vedic Astrology, Vastu and Palmistry consultations with Deepak Maheshwari in New Delhi. Online consultations available in Hindi and English.',
  image = '/images/deepak-maheshwari-yellow.png',
  locale = 'en',
  structuredData
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://clickjyotish.in').toString();
const socialImage = new URL(image, Astro.site ?? 'https://clickjyotish.in').toString();
const translatedPages = new Set(['/', '/astrologer-in-new-delhi/', '/vedic-astrology-consultation/', '/vastu-consultation/', '/palmistry-consultation/', '/faq/']);
const englishPath = locale === 'hi' ? (Astro.url.pathname.replace(/^\/hi(?=\/|$)/, '') || '/') : Astro.url.pathname;
const hasHindiTranslation = translatedPages.has(englishPath);
const englishUrl = new URL(englishPath, Astro.site ?? 'https://clickjyotish.in').toString();
const hindiPath = englishPath === '/' ? '/hi/' : `/hi${englishPath}`;
const hindiUrl = new URL(hindiPath, Astro.site ?? 'https://clickjyotish.in').toString();
---
<!doctype html>
<html lang={locale} data-locale={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="msvalidate.01" content="E97D728D000CC632424730F63D5E4734" />
    <link rel="canonical" href={canonical} />
    {hasHindiTranslation && <>
      <link rel="alternate" hreflang="en" href={englishUrl} />
      <link rel="alternate" hreflang="hi" href={hindiUrl} />
      <link rel="alternate" hreflang="x-default" href={englishUrl} />
    </>}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content="#101936" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body data-page-locale={locale} data-hindi-path={hasHindiTranslation ? hindiPath : undefined} data-english-path={hasHindiTranslation ? englishPath : undefined}><SiteHeader /><slot /></body>
</html>
<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&family=Noto+Serif+Devanagari:wght@400;500;600;700&display=swap');
  :root { --ink:#18213d; --night:#101936; --paper:#fcfaf5; --gold:#c7913e; --mist:#edf0f6; --line:#dedbd1; }
  * { box-sizing:border-box; } html { scroll-behavior:smooth; } body { margin:0; background:var(--paper); color:var(--ink); font-family:"DM Sans","Noto Serif Devanagari",sans-serif; line-height:1.6; } a { color:inherit; text-decoration:none; } h1,h2,h3 { font-family:"Playfair Display","Noto Serif Devanagari",serif; line-height:1.12; } .wrap { width:min(1120px, calc(100% - 40px)); margin:auto; }
</style>
