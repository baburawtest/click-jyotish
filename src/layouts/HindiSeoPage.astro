---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, eyebrow = 'क्लिक ज्योतिष · वैदिक मार्गदर्शन', structuredData } = Astro.props;
---
<BaseLayout {title} {description} locale="hi" {structuredData}>
  <main class="wrap hindi-page">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    <article class="content"><slot /></article>
  </main>
  <footer class="hindi-footer"><div class="wrap footer-inner"><span>© {new Date().getFullYear()} क्लिक ज्योतिष</span><nav><a href="/hi/astrologer-in-new-delhi/">नई दिल्ली ज्योतिषी</a><a href="/hi/faq/">प्रश्नोत्तर</a><a href="/privacy-policy">गोपनीयता नीति</a><a href="/terms-and-conditions">नियम एवं शर्तें</a><a href="/disclaimer">अस्वीकरण</a></nav></div></footer>
</BaseLayout>
<style>
  .hindi-page{max-width:1000px;padding:72px 0 88px}.eyebrow{font-size:12px;letter-spacing:1.7px;color:#a86f1e;font-weight:800;margin:0 0 12px}.hindi-page h1{font-size:clamp(38px,6vw,60px);margin:0 0 18px}.lead{font-size:19px;color:#536076;max-width:820px;margin:0 0 42px}.content :global(h2){font-size:30px;margin:43px 0 13px}.content :global(h3){font-size:21px;margin:0 0 9px}.content :global(p),.content :global(li){font-size:16px;color:#4d566a}.content :global(li){margin:9px 0}.content :global(a){color:#9b631a;text-decoration:underline}.content :global(.intro-card){background:#eef8fc;border:1px solid #b8d9ea;border-radius:14px;padding:26px 28px;color:#2d4863}.content :global(.service-grid){display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin:30px 0}.content :global(.service-card){background:#fff;border:1px solid #dedbd1;border-radius:12px;padding:25px}.content :global(.service-card p){margin:0 0 18px}.content :global(.service-card a){font-weight:800;text-decoration:none}.content :global(.button-row){display:flex;flex-wrap:wrap;gap:12px;margin:28px 0}.content :global(.button-row a){display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 20px;border-radius:7px;text-decoration:none;font-weight:800}.content :global(.button-row a:first-child){background:#c7913e;color:#101936}.content :global(.button-row a:last-child){border:1px solid #c7913e;color:#845313;background:#fffdf9}.content :global(.faq-item){border-top:1px solid #dedbd1;padding:21px 0}.content :global(.faq-item:last-child){border-bottom:1px solid #dedbd1}.hindi-footer{background:#0b1126;color:#b4becd;padding:26px 0}.footer-inner{display:flex;gap:20px;justify-content:space-between;align-items:center;flex-wrap:wrap;font-size:13px}.hindi-footer nav{display:flex;flex-wrap:wrap;gap:14px}.hindi-footer a:hover{color:#dca34e}@media(max-width:720px){.content :global(.service-grid){grid-template-columns:1fr}.hindi-page{padding:46px 0 66px}.content :global(.button-row){flex-direction:column}.content :global(.button-row a){width:100%}}
</style>
